                                <lvc:CartesianChart Series="{Binding RetirementBucketSeries}" XAxes="{Binding ProjectionXAxes}" AnimationsSpeed="{Binding ChartAnimationsSpeed}" HeightRequest="260" SemanticProperties.Description="{Binding RetirementBucketDescription}" />
                                <Label Text="{Binding RetirementBucketSummary}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" FontSize="13" LineHeight="1.3" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="16" Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}" Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="10"><Entry Text="{Binding PlanNameText, Mode=TwoWay}" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="My Retirement Cash Flow Plan" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Name for this saved Retirement Cash Flow plan" /><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="{Binding SavePlanActionText}" Command="{Binding SavePlanCommand}" SemanticProperties.Description="{Binding SavePlanActionDescription}" Background="#9A5C17" TextColor="#FFFFFF" /><Button Grid.Column="1" Text="Export to Excel" Command="{Binding ExportCommand}" Background="#2B6F53" TextColor="#FFFFFF" /></Grid><Label IsVisible="{Binding HasExportStatusMessage}" Text="{Binding ExportStatusMessage}" FontSize="13" /></VerticalStackLayout></Border>
                    <controls:EducationalDisclaimerView />
                </VerticalStackLayout>
                <Border IsVisible="{Binding IsUnsupportedCalculator}" Padding="18" Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}" Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}" StrokeShape="RoundRectangle 8">
                    <Label Text="Calculator inputs, live results, plans, and export are being connected in the next vertical slice." TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" LineHeight="1.3" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
