<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:catalog="clr-namespace:MyFireNumber.Core.Calculators;assembly=MyFireNumber.Core"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             x:Class="MyFireNumber.Views.HomePage"
             x:DataType="viewModels:HomeViewModel"
             Title="Home"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,24,24,32" Spacing="24">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="&#xf201;"
                              FontFamily="FontAwesomeSolid"
                              VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                           FontSize="28"
                           SemanticProperties.Description="Financial progress" />
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                    <Label Text="MY FIRE NUMBER"
                           TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                           FontAttributes="Bold"
                           FontSize="12"
                           CharacterSpacing="1.2" />
                    <Label Text="Build your financial independence plan."
                           TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                           FontAttributes="Bold"
                           FontSize="30"
                           LineHeight="1.1"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Every calculation stays on this device. Results are estimates, not financial advice."
                           TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                           FontSize="15"
                           LineHeight="1.3" />
                    </VerticalStackLayout>
                </Grid>

                <Border IsVisible="{Binding HasRecentCalculators}"
                       Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                       Padding="18"
                       Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                       StrokeShape="RoundRectangle 12">
                   <VerticalStackLayout Spacing="12">
                       <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                           <Label Text="&#xf1da;"
                                  FontFamily="FontAwesomeSolid"
                                  VerticalTextAlignment="Center"
                                  TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                  SemanticProperties.Description="Recent calculators" />
                           <Label Grid.Column="1"
                                  Text="Recently used calculators"
                                  TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                  FontAttributes="Bold"
                                  FontSize="20" />
                       </Grid>
                       <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentCalculators}" Spacing="8">
                           <BindableLayout.ItemTemplate>
                               <DataTemplate x:DataType="catalog:CalculatorDefinition">
                                   <Border Padding="12"
                                           Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                           StrokeThickness="0"
                                           StrokeShape="RoundRectangle 10"
                                           SemanticProperties.Description="{Binding Title, StringFormat='Open recent {0} calculator'}">
                                       <Border.GestureRecognizers>
                                           <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=OpenCalculatorCommand}"
                                                                 CommandParameter="{Binding .}" />
                                       </Border.GestureRecognizers>
                                       <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="10">
                                           <Label Text="{Binding IconGlyph}"
                                                  FontFamily="FontAwesomeSolid"
                                                  FontSize="16"
                                                  HorizontalTextAlignment="Center"
                                                  VerticalTextAlignment="Center"
                                                  TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                                  SemanticProperties.Description="{Binding Title, StringFormat='{0} icon'}" />
                                           <Label Grid.Column="1"
                                                  Text="{Binding Title}"
                                                  VerticalTextAlignment="Center"
                                                  TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                                  FontAttributes="Bold" />
                                           <Label Grid.Column="2"
                                                  Text="&#xf054;"
                                                  FontFamily="FontAwesomeSolid"
                                                  VerticalTextAlignment="Center"
                                                  TextColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                                  SemanticProperties.Description="Open" />
                                       </Grid>
                                   </Border>
                               </DataTemplate>
                           </BindableLayout.ItemTemplate>
                       </VerticalStackLayout>
                   </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasRecentPlans}"
                       Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                       Padding="18"
                       Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                       StrokeShape="RoundRectangle 12">
                   <VerticalStackLayout Spacing="12">
                       <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                           <Label Text="&#xf15c;"
                                  FontFamily="FontAwesomeSolid"
                                  VerticalTextAlignment="Center"
                                  TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                  SemanticProperties.Description="Recent plans" />
                           <Label Grid.Column="1"
                                  Text="Recently opened plans"
                                  TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                  FontAttributes="Bold"
                                  FontSize="20" />
                       </Grid>
                       <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentPlans}" Spacing="8">
                           <BindableLayout.ItemTemplate>
                               <DataTemplate x:DataType="viewModels:RecentPlanItem">
                                   <Border Padding="12"
                                           Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                           StrokeThickness="0"
                                           StrokeShape="RoundRectangle 10"
                                           SemanticProperties.Description="{Binding Name, StringFormat='Open recent plan {0}'}">
                                       <Border.GestureRecognizers>
                                           <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=OpenPlanCommand}"
                                                                 CommandParameter="{Binding .}" />
                                       </Border.GestureRecognizers>
                                       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                           <VerticalStackLayout Spacing="2">
                                               <Label Text="{Binding Name}"
                                                      TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                                      FontAttributes="Bold" />
                                               <Label Text="{Binding CalculatorTitle}"
                                                      TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                                      FontSize="12" />
                                           </VerticalStackLayout>
                                           <Label Grid.Column="1"
                                                  Text="&#xf054;"
                                                  FontFamily="FontAwesomeSolid"
                                                  VerticalTextAlignment="Center"
                                                  TextColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                                  SemanticProperties.Description="Open" />
                                       </Grid>
                                   </Border>
                               </DataTemplate>
                           </BindableLayout.ItemTemplate>
                       </VerticalStackLayout>
                   </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding ShowGettingStarted}"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                        Padding="18"
                        Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="14">
                           <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="&#xf1ec;"
                                FontFamily="FontAwesomeSolid"
                                VerticalTextAlignment="Center"
                                TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                   SemanticProperties.Description="Calculator" />
                            <Label Grid.Column="1"
                                Text="Your FIRE starting point"
                                TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                FontAttributes="Bold"
                                FontSize="20" />
                           </Grid>
                        <Border IsVisible="{Binding HasQuizRecommendation}"
                                Padding="14"
                                Background="{AppThemeBinding Light=#EAF4EC, Dark=#15211C}"
                                Stroke="{AppThemeBinding Light=#A8D4B2, Dark=#43805B}"
                                StrokeShape="RoundRectangle 10"
                                SemanticProperties.Description="{Binding RecommendedCalculator.Title, StringFormat='Open your recommended {0} calculator'}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCalculatorCommand}"
                                                      CommandParameter="{Binding RecommendedCalculator}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding RecommendedCalculator.IconGlyph}"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="20"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                       SemanticProperties.Description="Quiz recommendation" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Recommended from your quiz"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}" />
                                    <Label Text="{Binding RecommendedCalculator.Title}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" />
                                    <Label Text="{Binding RecommendedCalculator.Summary}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="&#xf054;"
                                       FontFamily="FontAwesomeSolid"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                       SemanticProperties.Description="Open" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding ShowFeaturedCalculators}"
                                             BindableLayout.ItemsSource="{Binding FeaturedCalculators}"
                                             Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="catalog:CalculatorDefinition">
                                    <Border Padding="10,8"
                                            StrokeThickness="0"
                                            Background="Transparent"
                                            SemanticProperties.Description="{Binding Title, StringFormat='Open {0} calculator'}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=OpenCalculatorCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Title}"
                                                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding Summary}"
                                                       TextColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                                       FontSize="13" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="&#xf054;"
                                                   FontFamily="FontAwesomeSolid"
                                                   VerticalTextAlignment="Center"
                                                   TextColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                                   SemanticProperties.Description="Open" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Retake quiz"
                                    Command="{Binding RetakeQuizCommand}"
                                    Background="{AppThemeBinding Light=#E4F0E9, Dark=#29483B}"
                                    TextColor="{AppThemeBinding Light=#245744, Dark=#C8E7D5}">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf2f1;" Color="{AppThemeBinding Light=#245744, Dark=#C8E7D5}" Size="14" />
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Column="1"
                                    Text="Browse all"
                                    Command="{Binding BrowseCalculatorsCommand}"
                                    Background="#2F6B57"
                                    TextColor="#FFFFFF">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf00e;" Color="#FFFFFF" Size="14" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>