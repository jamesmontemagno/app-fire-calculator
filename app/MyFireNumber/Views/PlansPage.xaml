<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFireNumber.Views.PlansPage"
             Title="Plans"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">

    <Grid Padding="24">
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
            <Label Text="Saved plans"
                   TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                   FontAttributes="Bold"
                   FontSize="26"
                   HorizontalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Save a calculator scenario to compare your plans here."
                   TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                   HorizontalTextAlignment="Center"
                   LineHeight="1.3" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>