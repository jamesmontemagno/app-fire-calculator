<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             x:Class="MyFireNumber.Views.PlansPage"
             x:DataType="viewModels:PlansViewModel"
             Title="Plans"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">

    <Grid Padding="20,16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Label Text="&#xf15c;"
                   FontFamily="FontAwesomeSolid"
                   VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                   FontSize="28"
                   SemanticProperties.Description="Saved plans" />
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="Saved plans"
                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                       FontAttributes="Bold"
                       FontSize="28"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Your scenarios are stored locally on this device."
                       TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                       FontSize="14" />
            </VerticalStackLayout>
        </Grid>

        <Border Grid.Row="1"
                Padding="10,8"
                Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                StrokeShape="RoundRectangle 12">
            <Grid RowDefinitions="Auto,1,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="&#xf002;"
                       FontFamily="FontAwesomeSolid"
                       FontSize="15"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                       SemanticProperties.Description="Search" />
                <SearchBar Grid.Column="1"
                           Placeholder="Search saved plans"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           Background="Transparent"
                           TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                           PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                           SemanticProperties.Description="Search saved plans by name." />
                <BoxView Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Margin="0,4"
                         HeightRequest="1"
                         Background="{AppThemeBinding Light=#E1E7E2, Dark=#365244}" />
                <Label Grid.Row="2"
                       Text="&#xf0b0;"
                       FontFamily="FontAwesomeSolid"
                       FontSize="14"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                       SemanticProperties.Description="Filter" />
                <Picker Grid.Row="2"
                        Grid.Column="1"
                        Title="All calculators"
                        ItemsSource="{Binding CalculatorFilters}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedCalculatorFilter, Mode=TwoWay}"
                        Background="Transparent"
                        TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                        TitleColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                        SemanticProperties.Description="Filter saved plans by calculator." />
            </Grid>
        </Border>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           SemanticProperties.Description="Loading saved plans." />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Plans}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:PlanListItem">
                   <SwipeView Margin="0,0,0,10">
                       <SwipeView.RightItems>
                           <SwipeItems Mode="Reveal">
                               <SwipeItem Text="Rename"
                                          BackgroundColor="#326B57"
                                          Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PlansViewModel}}, Path=RenamePlanCommand}"
                                          CommandParameter="{Binding .}"
                                          SemanticProperties.Description="Rename this saved plan." />
                               <SwipeItem Text="Duplicate"
                                          BackgroundColor="#426B9D"
                                          Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PlansViewModel}}, Path=DuplicatePlanCommand}"
                                          CommandParameter="{Binding .}"
                                          SemanticProperties.Description="Duplicate this saved plan." />
                               <SwipeItem Text="Delete"
                                          BackgroundColor="#A33A31"
                                          Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PlansViewModel}}, Path=DeletePlanCommand}"
                                          CommandParameter="{Binding .}"
                                          SemanticProperties.Description="Delete this saved plan after confirmation." />
                           </SwipeItems>
                       </SwipeView.RightItems>
                       <Border Padding="16"
                               Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                               Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                               StrokeShape="RoundRectangle 12"
                               SemanticProperties.Description="{Binding Name, StringFormat='Open saved plan {0}. Swipe left for more actions.'}">
                           <Border.GestureRecognizers>
                               <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PlansViewModel}}, Path=OpenPlanCommand}"
                                                     CommandParameter="{Binding .}" />
                           </Border.GestureRecognizers>
                           <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                               <VerticalStackLayout Spacing="3">
                                   <Label Text="{Binding Name}"
                                          TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                          FontAttributes="Bold"
                                          FontSize="18" />
                                   <Label Text="{Binding CalculatorTitle}"
                                          TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                          FontSize="13" />
                                   <Label Text="{Binding UpdatedDescription}"
                                          TextColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                          FontSize="12" />
                               </VerticalStackLayout>
                               <Label Grid.Column="1"
                                      Text="&#xf054;"
                                      FontFamily="FontAwesomeSolid"
                                      FontSize="14"
                                      VerticalTextAlignment="Center"
                                      TextColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                      SemanticProperties.Description="Open" />
                           </Grid>
                       </Border>
                   </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                    <Label Text="&#xf15c;"
                           FontFamily="FontAwesomeSolid"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                           FontSize="34"
                           SemanticProperties.Description="No saved plans" />
                    <Label Text="No saved plans yet."
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold"
                           FontSize="18" />
                    <Label Text="Save a calculator scenario to compare it here."
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>