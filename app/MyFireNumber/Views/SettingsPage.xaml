<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             x:Class="MyFireNumber.Views.SettingsPage"
             x:DataType="viewModels:SettingsViewModel"
             Title="Settings"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="18">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Label Text="&#xf013;"
                              FontFamily="FontAwesomeSolid"
                              VerticalTextAlignment="Center"
                          TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                          FontSize="28"
                           SemanticProperties.Description="Settings" />
                      <Label Grid.Column="1"
                          Text="Settings"
                          TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                          FontAttributes="Bold"
                          FontSize="30"
                          SemanticProperties.HeadingLevel="Level1" />
                  </Grid>
                <Border Padding="18"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                        Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="12">
                           <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="&#xf023;"
                                FontFamily="FontAwesomeSolid"
                                VerticalTextAlignment="Center"
                                TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                   SemanticProperties.Description="Privacy" />
                            <Label Grid.Column="1"
                                Text="Privacy first"
                                TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                FontAttributes="Bold"
                                FontSize="18" />
                           </Grid>
                        <Label Text="Your financial inputs are stored locally on this device. My Fire Number does not use analytics or transmit financial data."
                               TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                               LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="18"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                        Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Home calculators"
                                   TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                   FontAttributes="Bold"
                                   FontSize="18" />
                            <Label Text="Choose the calculators shown on Home and arrange their order."
                                   TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                                   LineHeight="1.3" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="10"
                                             BindableLayout.ItemsSource="{Binding CalculatorPreferences}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:CalculatorPreferenceItem">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <Label Text="{Binding Title}"
                                           VerticalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" />
                                    <Button Grid.Column="1"
                                            Text="Up"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SettingsViewModel}}, Path=MoveCalculatorUpCommand}"
                                            CommandParameter="{Binding .}"
                                            Background="#E4F0E9"
                                            TextColor="#245744"
                                            FontSize="12"
                                            MinimumWidthRequest="52"
                                            SemanticProperties.Description="Move this calculator earlier on Home." />
                                    <Button Grid.Column="2"
                                            Text="Down"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SettingsViewModel}}, Path=MoveCalculatorDownCommand}"
                                            CommandParameter="{Binding .}"
                                            Background="#E4F0E9"
                                            TextColor="#245744"
                                            FontSize="12"
                                            MinimumWidthRequest="58"
                                            SemanticProperties.Description="Move this calculator later on Home." />
                                    <Button Grid.Column="3"
                                            Text="{Binding VisibilityAction}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SettingsViewModel}}, Path=ToggleCalculatorVisibilityCommand}"
                                            CommandParameter="{Binding .}"
                                            Background="#2F6B57"
                                            TextColor="#FFFFFF"
                                            FontSize="12"
                                            MinimumWidthRequest="58"
                                            SemanticProperties.Description="Show or hide this calculator on Home." />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Padding="18"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                        Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="&#xf53f;"
                                   FontFamily="FontAwesomeSolid"
                                   VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                   SemanticProperties.Description="Appearance" />
                            <Label Grid.Column="1"
                                   Text="Appearance"
                                   TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                   FontAttributes="Bold"
                                   FontSize="18" />
                        </Grid>
                        <Label Text="Choose whether the app follows your device appearance or always uses a light or dark theme."
                               TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                               LineHeight="1.3" />
                        <Picker Title="Theme"
                                ItemsSource="{Binding ThemeOptions}"
                                SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                TitleColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                SemanticProperties.Description="Choose system, light, or dark app appearance." />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Retake FIRE Quiz"
                        Command="{Binding RetakeQuizCommand}"
                        Background="#2F6B57"
                        TextColor="#FFFFFF">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf01e;" Color="#FFFFFF" Size="14" />
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>