<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyFireNumber.Views.Controls"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             x:Class="MyFireNumber.Views.OnboardingChoicePage"
             x:DataType="viewModels:OnboardingChoiceViewModel"
             Title="Choose a starting point"
             Shell.TabBarIsVisible="False"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,20,24,32" Spacing="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Choose your starting point"
                           FontSize="28"
                           FontAttributes="Bold"
                           LineHeight="1.1"
                           TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Your defaults are saved. You can refine them any time in Settings."
                           LineHeight="1.3"
                           TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" />
                </VerticalStackLayout>

                <Border Padding="18"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                        Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Take the FIRE Quiz"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" />
                        <Label Text="Answer a few questions for a personalized calculator recommendation."
                               LineHeight="1.3"
                               TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" />
                        <Button AutomationId="OnboardingTakeQuizButton"
                                Text="Take the FIRE Quiz"
                                Command="{Binding TakeQuizCommand}"
                                Background="#2F6B57"
                                TextColor="#FFFFFF"
                                SemanticProperties.Description="Take the FIRE Quiz for a personalized calculator recommendation." />
                    </VerticalStackLayout>
                </Border>

                <Button AutomationId="OnboardingStartStandardFireButton"
                        Text="Start with Standard FIRE"
                        Command="{Binding StartStandardFireCommand}"
                        Background="Transparent"
                        BorderColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light=#2F6B57, Dark=#9ACCB3}"
                        SemanticProperties.Description="Open the Standard FIRE calculator with your saved defaults." />
                <Button AutomationId="OnboardingExploreOnMyOwnButton"
                        Text="Explore on my own"
                        Command="{Binding ExploreOnMyOwnCommand}"
                        Background="Transparent"
                        TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                        SemanticProperties.Description="Finish setup and explore all calculators on your own." />

                <controls:EducationalDisclaimerView />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
