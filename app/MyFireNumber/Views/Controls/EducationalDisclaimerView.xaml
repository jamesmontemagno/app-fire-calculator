<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFireNumber.Views.Controls.EducationalDisclaimerView"
             AutomationId="EducationalDisclaimer">
    <Grid RowDefinitions="1,Auto"
          Padding="4,8,4,0">
        <BoxView Background="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />
        <Grid Grid.Row="1"
              Margin="0,8,0,0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="{StaticResource SpaceSm}">
            <Label Text="&#xf071;"
                   FontFamily="FontAwesomeSolid"
                   FontSize="16"
                   VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}"
                   SemanticProperties.Description="Disclaimer" />
            <Label Grid.Column="1"
                   Text="For educational and informational purposes only. Not financial, investment, tax, or legal advice. Check your inputs and review results carefully; projections are estimates, not guarantees, and actual results will vary. Consult qualified professionals before making financial decisions."
                   FontSize="11"
                   LineHeight="1.25"
                   TextColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}"
                   SemanticProperties.Description="For educational and informational purposes only. Not financial, investment, tax, or legal advice. Check your inputs and review results carefully; projections are estimates, not guarantees, and actual results will vary. Consult qualified professionals before making financial decisions." />
        </Grid>
    </Grid>
</ContentView>
