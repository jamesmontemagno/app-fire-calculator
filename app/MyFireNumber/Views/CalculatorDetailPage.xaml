<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyFireNumber.Views.Controls"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="MyFireNumber.Views.CalculatorDetailPage"
             x:DataType="viewModels:CalculatorDetailViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding SavePlanActionText}"
                    Order="Primary"
                    Priority="0"
                    Command="{Binding SavePlanCommand}"
                    SemanticProperties.Description="{Binding SavePlanActionDescription}">
            <ToolbarItem.IconImageSource>
               <FontImageSource FontFamily="FontAwesomeSolid"
                                Glyph="&#xf0c7;"
                                Color="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                Size="18" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="Export"
                    Order="Primary"
                    Priority="2"
                    Command="{Binding ExportCommand}"
                    SemanticProperties.Description="Export this calculator to Excel.">
            <ToolbarItem.IconImageSource>
               <FontImageSource FontFamily="FontAwesomeSolid"
                                Glyph="&#xf56e;"
                                Color="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                Size="18" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,32" Spacing="18">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center"
                                   SemanticProperties.Description="Restoring your local calculator draft." />

                <Border IsVisible="{Binding HasValidationMessage}"
                        Padding="14"
                        Background="{AppThemeBinding Light=#FFF4E8, Dark=#4A3323}"
                        Stroke="{AppThemeBinding Light=#C97727, Dark=#F2B56D}"
                        StrokeShape="RoundRectangle 8">
                    <Label Text="{Binding ValidationMessage}"
                           TextColor="{AppThemeBinding Light=#6B3B12, Dark=#FFE0BC}"
                           LineHeight="1.3" />
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsStandardFireOrLeanFire}" Spacing="18">
                    <Border IsVisible="{Binding IsLeanFire}"
                            Padding="16"
                            Background="{AppThemeBinding Light=#EAF4EC, Dark=#1B3B2D}"
                            Stroke="{AppThemeBinding Light=#A8D4B2, Dark=#43805B}"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#xf06c;" FontFamily="FontAwesomeSolid" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#2F6B57, Dark=#9ACCB3}" SemanticProperties.Description="Lean FIRE guidance" />
                                <Label Grid.Column="1" Text="{Binding LeanStatusText}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" FontAttributes="Bold" FontSize="20" />
                            </Grid>
                            <Label Text="{Binding LeanGuidanceText}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Border>

                    <Border IsVisible="{Binding IsFatFire}"
                            Padding="16"
                            Background="{AppThemeBinding Light=#F1EDF8, Dark=#34284A}"
                            Stroke="{AppThemeBinding Light=#C8B9E2, Dark=#705993}"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#xf219;" FontFamily="FontAwesomeSolid" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#694C91, Dark=#D6C4F2}" SemanticProperties.Description="Fat FIRE guidance" />
                                <Label Grid.Column="1" Text="{Binding FatStatusText}" TextColor="{AppThemeBinding Light=#33204D, Dark=#F1ECFF}" FontAttributes="Bold" FontSize="20" />
                            </Grid>
                            <Label Text="{Binding FatGuidanceText}" TextColor="{AppThemeBinding Light=#58456D, Dark=#DCCFF1}" LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Border>

                    <Border IsVisible="{Binding IsStandardFire}"
                            Padding="16"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                            Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#xf0e7;"
                                       FontFamily="FontAwesomeSolid"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                       SemanticProperties.Description="Quick presets" />
                                <Label Grid.Column="1"
                                       Text="Quick presets"
                                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                       FontAttributes="Bold"
                                       FontSize="20" />
                            </Grid>
                            <Picker Title="Choose a starting point"
                                    ItemsSource="{Binding StandardFirePresets}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                    Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                    TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                    TitleColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                    SemanticProperties.Description="Choose a complete Standard FIRE preset to replace the current assumptions." />
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                            Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Text="&#xf201;"
                                        FontFamily="FontAwesomeSolid"
                                        VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                       SemanticProperties.Description="Financial inputs" />
                                <Label Grid.Column="1"
                                       Text="Your assumptions"
                                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                       FontAttributes="Bold"
                                       FontSize="20" />
                                <Button Grid.Column="2"
                                        Text="Reset"
                                        Command="{Binding ResetDefaultsCommand}"
                                        Background="#E4F0E9"
                                        TextColor="#245744"
                                        FontSize="12"
                                        MinimumWidthRequest="86"
                                        SemanticProperties.Description="Reset Standard FIRE values to their defaults.">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf01e;" Color="#245744" Size="12" />
                                    </Button.ImageSource>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Current age" FontAttributes="Bold" />
                                    <Entry Text="{Binding CurrentAgeText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="30" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Current age in years" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Retirement age" FontAttributes="Bold" />
                                    <Entry Text="{Binding RetirementAgeText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="55" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Target retirement age in years" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                    <Label Text="Current savings" FontAttributes="Bold" />
                                    <Entry Text="{Binding CurrentSavingsText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="100000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Current invested savings in dollars" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Spacing="4">
                                    <Label Text="Annual contribution" FontAttributes="Bold" />
                                    <Entry Text="{Binding AnnualContributionText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="24000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Annual contribution in dollars" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                    <Label Text="Annual net income" FontAttributes="Bold" />
                                    <Entry Text="{Binding AnnualIncomeText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="72000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Annual after-tax income in dollars" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="4">
                                    <Label Text="Annual retirement expenses" FontAttributes="Bold" />
                                    <Entry Text="{Binding AnnualExpensesText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="48000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Expected annual retirement expenses in dollars" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="4" Spacing="4">
                                    <Label Text="Expected return (%)" FontAttributes="Bold" />
                                    <Entry Text="{Binding ExpectedReturnText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="7" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Expected annual investment return as a percentage" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="4" Grid.Column="1" Spacing="4">
                                    <Label Text="Inflation (%)" FontAttributes="Bold" />
                                    <Entry Text="{Binding InflationRateText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="3" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Annual inflation rate as a percentage" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Safe withdrawal rate (%)" FontAttributes="Bold" />
                                <Entry Text="{Binding WithdrawalRateText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="4" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Safe annual withdrawal rate as a percentage" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                            Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#xf15c;"
                                       FontFamily="FontAwesomeSolid"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                       SemanticProperties.Description="Saved plan" />
                                <Label Grid.Column="1"
                                       Text="Save this scenario"
                                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                       FontAttributes="Bold"
                                       FontSize="20" />
                            </Grid>
                            <Label Text="Plan name" FontAttributes="Bold" />
                            <Entry Text="{Binding PlanNameText, Mode=TwoWay}"
                                   Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                   TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                Placeholder="{Binding PlanNamePlaceholder}"
                                   PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                SemanticProperties.Description="{Binding PlanNameDescription}" />
                            <Button Text="{Binding SavePlanActionText}"
                                    Command="{Binding SavePlanCommand}"
                                    SemanticProperties.Description="{Binding SavePlanActionDescription}"
                                    Background="#2F6B57"
                                    TextColor="#FFFFFF">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf0c7;" Color="#FFFFFF" Size="14" />
                                </Button.ImageSource>
                            </Button>
                            <Label IsVisible="{Binding HasPlanStatusMessage}"
                                   Text="{Binding PlanStatusMessage}"
                                   TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                                   FontSize="13"
                                   LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                            Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#xf201;" FontFamily="FontAwesomeSolid" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}" SemanticProperties.Description="Live results" />
                                <Label Grid.Column="1" Text="{Binding OutlookTitle}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" FontAttributes="Bold" FontSize="20" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                <Border Padding="12" Background="{AppThemeBinding Light=#E4F0E9, Dark=#29483B}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="{Binding FireNumberLabel}" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" /><Label Text="{Binding FireNumberText}" FontAttributes="Bold" FontSize="22" /></VerticalStackLayout></Border>
                                <Border Grid.Column="1" Padding="12" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="{Binding YearsToFireLabel}" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" /><Label Text="{Binding YearsToFireText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                                <Border Grid.Row="1" Padding="12" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="FIRE age" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" /><Label Text="{Binding FireAgeText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                                <Border Grid.Row="1" Grid.Column="1" Padding="12" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="Savings rate" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" /><Label Text="{Binding SavingsRateText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                                <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="12" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="Monthly contribution" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" /><Label Text="{Binding MonthlyContributionText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                            </Grid>
                            <VerticalStackLayout Spacing="6">
                                <ProgressBar Progress="{Binding ProgressToFire}" />
                                <Label Text="{Binding ProgressDescription}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" FontSize="13" SemanticProperties.Description="{Binding ProgressDescription}" />
                                <Label Text="{Binding ProjectionSummary}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" FontSize="13" LineHeight="1.3" />
                            </VerticalStackLayout>
                                    <Button IsVisible="{Binding IsStandardFireOrLeanFire}"
                                    Text="Export to Excel"
                                    Command="{Binding ExportCommand}"
                                    Background="#2F6B57"
                                    TextColor="#FFFFFF"
                                        SemanticProperties.Description="{Binding ExportDescription}">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf56d;" Color="#FFFFFF" Size="14" />
                                </Button.ImageSource>
                            </Button>
                            <Label IsVisible="{Binding HasExportStatusMessage}"
                                   Text="{Binding ExportStatusMessage}"
                                   TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                                   FontSize="13"
                                   LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                            Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#xf201;"
                                       FontFamily="FontAwesomeSolid"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                                       SemanticProperties.Description="Portfolio projection" />
                                <Label Grid.Column="1"
                                       Text="{Binding ProjectionTitle}"
                                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                       FontAttributes="Bold"
                                       FontSize="20" />
                            </Grid>
                            <lvc:CartesianChart Series="{Binding ProjectionSeries}"
                                                XAxes="{Binding ProjectionXAxes}"
                                                AnimationsSpeed="{Binding ChartAnimationsSpeed}"
                                                HeightRequest="260"
                                                SemanticProperties.Description="{Binding ProjectionChartDescription}" />
                            <Label Text="{Binding ProjectionSummary}"
                                   TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                                   FontSize="13"
                                   LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16" Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}" Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Strategy comparison" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" FontAttributes="Bold" FontSize="20" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2"><Label Text="Snowball" FontAttributes="Bold" /><Label Text="{Binding DebtSnowballComparisonText}" FontSize="13" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="Avalanche" FontAttributes="Bold" /><Label Text="{Binding DebtAvalancheComparisonText}" FontSize="13" /></VerticalStackLayout>
                            </Grid>
                            <Button Text="Export to Excel" Command="{Binding ExportCommand}" Background="#9A5C17" TextColor="#FFFFFF" SemanticProperties.Description="Create a Debt Payoff workbook on this device and open the native share sheet.">
                                <Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf56d;" Color="#FFFFFF" Size="14" /></Button.ImageSource>
                            </Button>
                            <Label IsVisible="{Binding HasExportStatusMessage}" Text="{Binding ExportStatusMessage}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                    <controls:EducationalDisclaimerView />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsCoastFire}" Spacing="18">
                    <Border Padding="16"
                            Background="{AppThemeBinding Light=#EAF2FF, Dark=#1D3040}"
                            Stroke="{AppThemeBinding Light=#AFC9E8, Dark=#3F6685}"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#xf0eb;"
                                       FontFamily="FontAwesomeSolid"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#245D8B, Dark=#A9D5FF}"
                                       SemanticProperties.Description="Coast FIRE explanation" />
                                <Label Grid.Column="1"
                                       Text="What is Coast FIRE?"
                                       TextColor="{AppThemeBinding Light=#173B5B, Dark=#E0F1FF}"
                                       FontAttributes="Bold"
                                       FontSize="20" />
                            </Grid>
                            <Label Text="You've reached Coast FIRE when your current savings can grow to your full FIRE Number by retirement age without another contribution."
                                   TextColor="{AppThemeBinding Light=#24506F, Dark=#C7E4FA}"
                                   LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                            Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Text="&#xf1ec;"
                                       FontFamily="FontAwesomeSolid"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#245D8B, Dark=#A9D5FF}"
                                       SemanticProperties.Description="Coast FIRE assumptions" />
                                <Label Grid.Column="1"
                                       Text="Your Coast FIRE assumptions"
                                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                       FontAttributes="Bold"
                                       FontSize="20" />
                                <Button Grid.Column="2"
                                        Text="Reset"
                                        Command="{Binding ResetDefaultsCommand}"
                                        Background="#E4F0E9"
                                        TextColor="#245744"
                                        FontSize="12"
                                        MinimumWidthRequest="86"
                                        SemanticProperties.Description="Reset Coast FIRE values to their defaults.">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf01e;" Color="#245744" Size="12" />
                                    </Button.ImageSource>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Current age" FontAttributes="Bold" />
                                    <Entry Text="{Binding CurrentAgeText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="30" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Current age in years" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Retirement age" FontAttributes="Bold" />
                                    <Entry Text="{Binding RetirementAgeText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="55" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Target retirement age in years" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                    <Label Text="Current savings" FontAttributes="Bold" />
                                    <Entry Text="{Binding CurrentSavingsText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="100000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Current invested savings in dollars" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Spacing="4">
                                    <Label Text="Annual contribution" FontAttributes="Bold" />
                                    <Entry Text="{Binding AnnualContributionText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="24000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Annual contribution in dollars" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                    <Label Text="Annual retirement expenses" FontAttributes="Bold" />
                                    <Entry Text="{Binding AnnualExpensesText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="48000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Expected annual retirement expenses in dollars" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="3" Spacing="4">
                                    <Label Text="Expected return (%)" FontAttributes="Bold" />
                                    <Entry Text="{Binding ExpectedReturnText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="7" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Expected annual investment return as a percentage" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="4">
                                    <Label Text="Inflation (%)" FontAttributes="Bold" />
                                    <Entry Text="{Binding InflationRateText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="3" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Annual inflation rate as a percentage" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Safe withdrawal rate (%)" FontAttributes="Bold" />
