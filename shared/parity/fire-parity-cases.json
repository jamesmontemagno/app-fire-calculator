        "monthlyPayment": 500,
        "extraPayment": 0,
        "strategy": "snowball"
      },
      "expected": {
        "totalMonths": 25,
        "totalInterest": 2266,
        "totalPrincipal": 10000,
        "monthlyPayment": 500,
        "firstMonthInterest": 166.66666666666666,
        "payoffOrder": [
          "Card"
        ]
      }
    },
