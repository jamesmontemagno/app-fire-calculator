<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyFireNumber.Views.Controls"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             x:Class="MyFireNumber.Views.DefaultsOnboardingPage"
             x:DataType="viewModels:DefaultsOnboardingViewModel"
             Title="About you"
             Shell.NavBarIsVisible="True"
             Shell.TabBarIsVisible="False"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Skip"
                     Command="{Binding SkipCommand}"
                     SemanticProperties.Description="Skip these details and continue to withdrawal rate." />
    </ContentPage.ToolbarItems>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,20,24,32" Spacing="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Tell us about today"
                           FontSize="28"
                           FontAttributes="Bold"
                           LineHeight="1.1"
                           TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="These three details give your calculators a useful starting point. You can fine-tune everything later."
                           LineHeight="1.35"
                           TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" />
                </VerticalStackLayout>

                <Border Padding="18"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                        Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="22">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Current age"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" />
                                <Label Grid.Column="1"
                                       Text="{Binding CurrentAgeText}"
                                       TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}" />
                            </Grid>
                            <Slider AutomationId="OnboardingCurrentAgeSlider"
                                    Minimum="18"
                                    Maximum="80"
                                    Value="{Binding CurrentAge}"
                                    MinimumTrackColor="#2F6B57"
                                    MaximumTrackColor="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                                    ThumbColor="#2F6B57"
                                    SemanticProperties.Description="Current age" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="After-tax take-home income"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" />
                                <Label Grid.Column="1"
                                        Text="{Binding AnnualIncomeText, Mode=OneWay}"
                                       TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}" />
                            </Grid>
                            <Slider AutomationId="OnboardingAnnualIncomeSlider"
                                    Minimum="0"
                                    Maximum="{Binding MaximumAnnualIncome}"
                                    Value="{Binding AnnualIncome, Mode=TwoWay}"
                                    MinimumTrackColor="#2F6B57"
                                    MaximumTrackColor="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                                    ThumbColor="#2F6B57"
                                    SemanticProperties.Description="Current annual after-tax take-home income in dollars" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Current annual expenses"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" />
                                <Label Grid.Column="1"
                                        Text="{Binding AnnualExpensesText, Mode=OneWay}"
                                       TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}" />
                            </Grid>
                            <Slider AutomationId="OnboardingAnnualExpensesSlider"
                                    Minimum="0"
                                    Maximum="{Binding MaximumAnnualExpenses}"
                                    Value="{Binding AnnualExpenses, Mode=TwoWay}"
                                    MinimumTrackColor="#2F6B57"
                                    MaximumTrackColor="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                                    ThumbColor="#2F6B57"
                                    SemanticProperties.Description="Current annual expenses in dollars" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button AutomationId="SaveOnboardingDefaultsButton"
                        Text="Continue"
                        Command="{Binding SaveAndContinueCommand}"
                        Background="#2F6B57"
                        TextColor="#FFFFFF"
                        SemanticProperties.Description="Save these details and continue to withdrawal rate." />

                <controls:EducationalDisclaimerView />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
