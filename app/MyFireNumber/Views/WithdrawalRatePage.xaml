<?xml version="1.0" encoding="utf-8" ?>
<views:CalculatorPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyFireNumber.Views.Controls"
             xmlns:views="clr-namespace:MyFireNumber.Views"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="MyFireNumber.Views.WithdrawalRatePage"
             x:DataType="viewModels:WithdrawalRateViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save"
                     Order="Primary"
                     Priority="0"
                     Command="{Binding SavePlanAndCloseCommand}"
                     SemanticProperties.Description="{Binding SavePlanActionDescription}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid"
                                 Glyph="&#xf0c7;"
                                 Color="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                 Size="18" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,32" Spacing="18">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="Restoring your local calculator draft." />

            <Border IsVisible="{Binding HasValidationMessage}"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFF4E8, Dark=#4A3323}"
                    Stroke="{AppThemeBinding Light=#C97727, Dark=#F2B56D}"
                    StrokeShape="RoundRectangle 8">
                <Label Text="{Binding ValidationMessage}"
                       TextColor="{AppThemeBinding Light=#6B3B12, Dark=#FFE0BC}"
                       LineHeight="1.3" />
            </Border>

            <controls:CalculatorInfoView Title="What is a withdrawal rate?"
                                         Summary="Test how long a portfolio may last while funding inflation-adjusted retirement spending."
                                         Details="A withdrawal rate is the percentage of your portfolio you spend in the first retirement year, with later withdrawals adjusted for inflation. The 4% rule is a common starting point, not a guarantee. This calculator may fit people at or near retirement who want to compare spending, market returns, and portfolio longevity."
                                         IconGlyph="&#xf02d;" />

            <Border Padding="16"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                    Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="&#xf201;"
                               FontFamily="FontAwesomeSolid"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#25698E, Dark=#A9DCF7}"
                               SemanticProperties.Description="Withdrawal assumptions" />
                        <Label Grid.Column="1"
                               Text="Your portfolio"
                               TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                               FontAttributes="Bold"
                               FontSize="20" />
                        <Button Grid.Column="2"
                                Text="Reset"
                                Command="{Binding ResetDefaultsCommand}"
                                Background="#E5F2F9"
                                TextColor="#174A67"
                                FontSize="12"
                                MinimumWidthRequest="86"
                                SemanticProperties.Description="Reset Withdrawal Rate values to their defaults.">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf01e;" Color="#174A67" Size="12" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Portfolio value" FontAttributes="Bold" />
                        <Entry Text="{Binding PortfolioValueText, Mode=TwoWay}"
                               Keyboard="Numeric"
                               Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                               TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                               Placeholder="1000000"
                               PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                               SemanticProperties.Description="Current total invested portfolio in dollars" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Withdrawal rate (%)" FontAttributes="Bold" />
                            <Entry Text="{Binding WithdrawalRateText, Mode=TwoWay}"
                                   Keyboard="Numeric"
                                   Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                   TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                   Placeholder="4"
                                   PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                   SemanticProperties.Description="Annual withdrawal rate percentage" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Retirement duration" FontAttributes="Bold" />
                            <Entry Text="{Binding RetirementYearsText, Mode=TwoWay}"
                                   Keyboard="Numeric"
                                   Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                   TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                   Placeholder="30"
                                   PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                   SemanticProperties.Description="Number of retirement years to model" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Spacing="4">
                            <Label Text="Expected return (%)" FontAttributes="Bold" />
                            <Entry Text="{Binding ExpectedReturnText, Mode=TwoWay}"
                                   Keyboard="Numeric"
                                   Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                   TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                   Placeholder="7"
                                   PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                   SemanticProperties.Description="Expected annual return percentage" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Label Text="Inflation (%)" FontAttributes="Bold" />
                            <Entry Text="{Binding InflationRateText, Mode=TwoWay}"
                                   Keyboard="Numeric"
                                   Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                   TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                   Placeholder="3"
                                   PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                   SemanticProperties.Description="Annual inflation percentage" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                    Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding WithdrawalStatusText}"
                           TextColor="{AppThemeBinding Light=#174A67, Dark=#C3E6F8}"
                           FontAttributes="Bold"
                           FontSize="18"
                           LineHeight="1.3" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Border Padding="12"
                                Background="{AppThemeBinding Light=#EAF5FC, Dark=#1B3546}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Annual withdrawal" FontSize="12" TextColor="{AppThemeBinding Light=#255D7D, Dark=#C3E6F8}" />
                                <Label Text="{Binding WithdrawalAnnualText}" FontAttributes="Bold" FontSize="22" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1"
                                Padding="12"
                                Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Monthly withdrawal" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" />
                                <Label Text="{Binding WithdrawalMonthlyText}" FontAttributes="Bold" FontSize="18" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1"
                                Padding="12"
                                Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Portfolio lasts" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" />
                                <Label Text="{Binding WithdrawalLongevityText}" FontAttributes="Bold" FontSize="18" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Padding="12"
                                Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Success rate" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" />
                                <Label Text="{Binding WithdrawalSuccessText}" FontAttributes="Bold" FontSize="18" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <Label Text="{Binding WithdrawalRateAnalysisText}"
                           TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                           FontSize="13"
                           LineHeight="1.3" />
                    <Button Text="Export to Excel"
                            Command="{Binding ExportCommand}"
                            Background="#25698E"
                            TextColor="#FFFFFF"
                            SemanticProperties.Description="Create a Withdrawal Rate workbook on this device and open the native share sheet.">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf56d;" Color="#FFFFFF" Size="14" />
                        </Button.ImageSource>
                    </Button>
                    <Label IsVisible="{Binding HasExportStatusMessage}"
                           Text="{Binding ExportStatusMessage}"
                           TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                           FontSize="13"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                    Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="&#xf15c;"
                               FontFamily="FontAwesomeSolid"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#25698E, Dark=#A9DCF7}"
                               SemanticProperties.Description="Saved Withdrawal Rate plan" />
                        <Label Grid.Column="1"
                               Text="Save this withdrawal plan"
                               TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                               FontAttributes="Bold"
                               FontSize="20" />
                    </Grid>
                    <Label Text="Plan name" FontAttributes="Bold" />
                    <Entry Text="{Binding PlanNameText, Mode=TwoWay}"
                           Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}"
                           TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                           Placeholder="My Withdrawal Plan"
                           PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                           SemanticProperties.Description="Name for this saved Withdrawal Rate plan" />
                    <Button Text="{Binding SavePlanActionText}"
                            Command="{Binding SavePlanCommand}"
                            SemanticProperties.Description="{Binding SavePlanActionDescription}"
                            Background="#25698E"
                            TextColor="#FFFFFF">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf0c7;" Color="#FFFFFF" Size="14" />
                        </Button.ImageSource>
                    </Button>
                    <Label IsVisible="{Binding HasPlanStatusMessage}"
                           Text="{Binding PlanStatusMessage}"
                           TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                           FontSize="13"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                    Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="&#xf201;"
                               FontFamily="FontAwesomeSolid"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#25698E, Dark=#A9DCF7}"
                               SemanticProperties.Description="Withdrawal balance projection" />
                        <Label Grid.Column="1"
                               Text="Portfolio balance over time"
                               TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                               FontAttributes="Bold"
                               FontSize="20" />
                    </Grid>
                    <lvc:CartesianChart Series="{Binding ProjectionSeries}"
                                        XAxes="{Binding ProjectionXAxes}"
                                        AnimationsSpeed="{Binding ChartAnimationsSpeed}"
                                        HeightRequest="300"
                                        SemanticProperties.Description="{Binding ProjectionChartDescription}" />
                </VerticalStackLayout>
            </Border>

            <controls:EducationalDisclaimerView />
        </VerticalStackLayout>
    </ScrollView>
</views:CalculatorPageBase>
