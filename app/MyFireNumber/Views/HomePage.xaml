<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:books="clr-namespace:MyFireNumber.Core.Books;assembly=MyFireNumber.Core"
             xmlns:catalog="clr-namespace:MyFireNumber.Core.Calculators;assembly=MyFireNumber.Core"
             xmlns:shimmer="clr-namespace:Syncfusion.Maui.Toolkit.Shimmer;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             x:Class="MyFireNumber.Views.HomePage"
             x:DataType="viewModels:HomeViewModel"
             Title="Home"
             Background="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}"
             SafeAreaEdges="Container">

    <shimmer:SfShimmer IsActive="{Binding IsLoading}"
                       Type="Feed"
                       BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}"
                       Fill="{AppThemeBinding Light={StaticResource SurfaceInsetLight}, Dark={StaticResource SurfaceInsetDark}}"
                       WaveColor="{AppThemeBinding Light={StaticResource SurfaceAccentTintPaleLight}, Dark={StaticResource SurfaceCardDark}}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceXl}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                    <Label Text="&#xf201;"
                              FontFamily="FontAwesomeSolid"
                              VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                           FontSize="28"
                           SemanticProperties.Description="Financial progress" />
                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpaceSm}">
                    <Label Text="MY FIRE NUMBER"
                           IsVisible="{Binding HasNoGreeting}"
                           TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                           FontAttributes="Bold"
                           FontSize="12"
                           CharacterSpacing="1.2" />
                    <Label Text="{Binding Greeting}"
                           AutomationId="HomeGreeting"
                           IsVisible="{Binding HasGreeting}"
                           TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                           FontAttributes="Bold"
                           FontSize="12"
                           CharacterSpacing="1.2" />
                    <Label Text="Build your financial independence plan."
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                           FontAttributes="Bold"
                           FontSize="30"
                           LineHeight="1.1"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Every calculation stays on this device. Results are estimates, not financial advice."
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           FontSize="15"
                           LineHeight="1.3" />
                    </VerticalStackLayout>
                </Grid>

                <Border Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                        Padding="{StaticResource CardPadding}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                            <Label Text="&#xf555;"
                                   FontFamily="FontAwesomeSolid"
                                   VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                                   FontSize="18"
                                   SemanticProperties.Description="Accounts" />
                            <Label Grid.Column="1" Text="Accounts" Style="{StaticResource CalculatorSectionHeading}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAccountsData}">
                            <Label Text="Hide dollar amounts" VerticalTextAlignment="Center" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Switch Grid.Column="1" AutomationId="HomePrivacyModeSwitch" IsToggled="{Binding IsPrivacyModeEnabled}" SemanticProperties.Description="Hide net worth, assets, and debts on this screen" />
                        </Grid>

                        <!-- No accounts yet: a single CTA, no stats to show. -->
                        <VerticalStackLayout IsVisible="{Binding HasNoAccountsData}" Spacing="{StaticResource SpaceSm}">
                            <Label Text="Add your first account, income source, or debt to start tracking your net worth."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>

                        <Label Text="Track your accounts, income, expenses, and debts, then run a monthly check-in to see your progress over time."
                               IsVisible="{Binding HasAccountsData}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceSm}" IsVisible="{Binding HasAccountsData}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Net worth" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label AutomationId="HomeNetWorthLabel" Text="{Binding NetWorthText}" FontAttributes="Bold" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}" />
                                <Label Text="{Binding NetWorthChangeText}" IsVisible="{Binding HasNetWorthChange}" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Assets" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Text="{Binding TotalAssetsText}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding TotalDebtsText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="2" IsVisible="{Binding HasAccountsData}">
                            <Label Text="{Binding CheckInFreshnessText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="{Binding NextCheckInText}"
                                   IsVisible="{Binding HasCompletedCheckIn}"
                                   FontSize="12"
                                   TextColor="{StaticResource FixedWarning}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceSm}">
                            <Button Text="Go to Accounts"
                                    AutomationId="HomeGoToAccountsButton"
                                    Command="{Binding GoToAccountsCommand}"
                                    Background="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}" />
                            <Button Grid.Column="1"
                                    Text="Start monthly check-in"
                                    AutomationId="HomeStartCheckInButton"
                                    Command="{Binding StartCheckInCommand}"
                                    IsVisible="{Binding HasAccountsData}" />
                        </Grid>

                        <!-- Trend UI only appears once at least one check-in exists; before that there is
                             nothing to trend, so the link stays hidden rather than opening an empty chart. -->
                        <Button Text="View history &amp; trends"
                                AutomationId="HomeViewHistoryButton"
                                Command="{Binding ViewHistoryCommand}"
                                IsVisible="{Binding HasCompletedCheckIn}"
                                Background="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasRecentCalculators}"
                       Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                       Padding="{StaticResource CardPadding}"
                       Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                       StrokeShape="RoundRectangle 12">
                   <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                       <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                           <Label Text="&#xf1da;"
                                  FontFamily="FontAwesomeSolid"
                                  VerticalTextAlignment="Center"
                                  TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                                  SemanticProperties.Description="Recent calculators" />
                           <Label Grid.Column="1"
                                  Text="Recently used calculators"
                                  TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                  FontAttributes="Bold"
                                  FontSize="20" />
                       </Grid>
                       <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentCalculators}" Spacing="{StaticResource SpaceSm}">
                           <BindableLayout.ItemTemplate>
                               <DataTemplate x:DataType="catalog:CalculatorDefinition">
                                   <Border Padding="{StaticResource CardPaddingCompact}"
                                           Background="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}"
                                           StrokeThickness="0"
                                           StrokeShape="RoundRectangle 10"
                                           SemanticProperties.Description="{Binding Title, StringFormat='Open recent {0} calculator'}">
                                       <Border.GestureRecognizers>
                                           <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=OpenCalculatorCommand}"
                                                                 CommandParameter="{Binding .}" />
                                       </Border.GestureRecognizers>
                                       <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                                           <Label Text="{Binding IconGlyph}"
                                                  FontFamily="FontAwesomeSolid"
                                                  FontSize="16"
                                                  HorizontalTextAlignment="Center"
                                                  VerticalTextAlignment="Center"
                                                  TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                                                  SemanticProperties.Description="{Binding Title, StringFormat='{0} icon'}" />
                                           <Label Grid.Column="1"
                                                  Text="{Binding Title}"
                                                  VerticalTextAlignment="Center"
                                                  TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                                  FontAttributes="Bold" />
                                           <Label Grid.Column="2"
                                                  Text="&#xf054;"
                                                  FontFamily="FontAwesomeSolid"
                                                  VerticalTextAlignment="Center"
                                                  TextColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}"
                                                  SemanticProperties.Description="Open" />
                                       </Grid>
                                   </Border>
                               </DataTemplate>
                           </BindableLayout.ItemTemplate>
                       </VerticalStackLayout>
                   </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasRecentPlans}"
                       Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                       Padding="{StaticResource CardPadding}"
                       Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                       StrokeShape="RoundRectangle 12">
                   <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                       <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                           <Label Text="&#xf15c;"
                                  FontFamily="FontAwesomeSolid"
                                  VerticalTextAlignment="Center"
                                  TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                                  SemanticProperties.Description="Recent plans" />
                           <Label Grid.Column="1"
                                  Text="Recently opened plans"
                                  TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                  FontAttributes="Bold"
                                  FontSize="20" />
                       </Grid>
                       <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentPlans}" Spacing="{StaticResource SpaceSm}">
                           <BindableLayout.ItemTemplate>
                               <DataTemplate x:DataType="viewModels:RecentPlanItem">
                                   <Border Padding="{StaticResource CardPaddingCompact}"
                                           Background="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}"
                                           StrokeThickness="0"
                                           StrokeShape="RoundRectangle 10"
                                           SemanticProperties.Description="{Binding Name, StringFormat='Open recent plan {0}'}">
                                       <Border.GestureRecognizers>
                                           <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=OpenPlanCommand}"
                                                                 CommandParameter="{Binding .}" />
                                       </Border.GestureRecognizers>
                                       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                                           <VerticalStackLayout Spacing="2">
                                               <Label Text="{Binding Name}"
                                                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                                      FontAttributes="Bold" />
                                               <Label Text="{Binding CalculatorTitle}"
                                                      TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                                                      FontSize="12" />
                                           </VerticalStackLayout>
                                           <Label Grid.Column="1"
                                                  Text="&#xf054;"
                                                  FontFamily="FontAwesomeSolid"
                                                  VerticalTextAlignment="Center"
                                                  TextColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}"
                                                  SemanticProperties.Description="Open" />
                                       </Grid>
                                   </Border>
                               </DataTemplate>
                           </BindableLayout.ItemTemplate>
                       </VerticalStackLayout>
                   </VerticalStackLayout>
                </Border>


                <Border IsVisible="{Binding ShowGettingStarted}"
                        Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                        Padding="{StaticResource CardPadding}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                           <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                            <Label Text="&#xf1ec;"
                                FontFamily="FontAwesomeSolid"
                                VerticalTextAlignment="Center"
                                TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                                   SemanticProperties.Description="Calculator" />
                            <Label Grid.Column="1"
                                Text="Suggested calculators"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                FontAttributes="Bold"
                                FontSize="20" />
                           </Grid>
                        <Border IsVisible="{Binding HasQuizRecommendation}"
                                Padding="14"
                                Background="{AppThemeBinding Light={StaticResource SurfaceAccentTintFlatLight}, Dark={StaticResource SurfaceAccentTintFlatDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderAccentSoftLight}, Dark={StaticResource BorderAccentSoftDark}}"
                                StrokeShape="RoundRectangle 10"
                                SemanticProperties.Description="{Binding RecommendedCalculator.Title, StringFormat='Open your recommended {0} calculator'}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCalculatorCommand}"
                                                      CommandParameter="{Binding RecommendedCalculator}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                                <Label Text="{Binding RecommendedCalculator.IconGlyph}"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="20"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                                       SemanticProperties.Description="Quiz recommendation" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Recommended from your quiz"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}" />
                                    <Label Text="{Binding RecommendedCalculator.Title}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding RecommendedCalculator.Summary}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="&#xf054;"
                                       FontFamily="FontAwesomeSolid"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}"
                                       SemanticProperties.Description="Open" />
                            </Grid>
                        </Border>
                        <Label IsVisible="{Binding ShowFeaturedCalculators}"
                               Text="Start with one of these to build your first estimate."
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               LineHeight="1.3" />
                        <VerticalStackLayout IsVisible="{Binding ShowFeaturedCalculators}"
                                             BindableLayout.ItemsSource="{Binding FeaturedCalculators}"
                                             Spacing="{StaticResource SpaceSm}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="catalog:CalculatorDefinition">
                                    <Border Padding="10,8"
                                            StrokeThickness="0"
                                            Background="Transparent"
                                            SemanticProperties.Description="{Binding Title, StringFormat='Open {0} calculator'}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=OpenCalculatorCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Title}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding Summary}"
                                                       TextColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}"
                                                       FontSize="13" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="&#xf054;"
                                                   FontFamily="FontAwesomeSolid"
                                                   VerticalTextAlignment="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}"
                                                   SemanticProperties.Description="Open" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceSm}">
                            <Button Text="Retake quiz"
                                    Command="{Binding RetakeQuizCommand}"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceAccentSoftLight}, Dark={StaticResource SurfaceAccentSoftDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextAccentStrongLight}, Dark={StaticResource TextAccentStrongDark}}">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf2f1;" Color="{AppThemeBinding Light={StaticResource TextAccentStrongLight}, Dark={StaticResource TextAccentStrongDark}}" Size="14" />
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Column="1"
                                    Text="Browse all"
                                    Command="{Binding BrowseCalculatorsCommand}"
                                    Background="{StaticResource FixedAccent}"
                                    TextColor="{StaticResource FixedWhite}">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf00e;" Color="{StaticResource FixedWhite}" Size="14" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding ShowRecommendedBooks}"
                        Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                        Padding="{StaticResource CardPadding}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 12">
                   <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                       <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                           <Label Text="&#xf02d;"
                                  FontFamily="FontAwesomeSolid"
                                  VerticalTextAlignment="Center"
                                  TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                                  SemanticProperties.Description="Recommended books" />
                           <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpaceXs}">
                               <Label Text="Recommended FIRE books"
                                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                      FontAttributes="Bold"
                                      FontSize="20"
                                      SemanticProperties.HeadingLevel="Level2" />
                               <Label Text="Essential reading for your financial independence journey."
                                      TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                      FontSize="13" />
                           </VerticalStackLayout>
                       </Grid>
                       <FlexLayout BindableLayout.ItemsSource="{Binding RecommendedBooks}"
                                   Direction="Row"
                                   Wrap="Wrap"
                                   JustifyContent="SpaceBetween">
                           <BindableLayout.ItemTemplate>
                               <DataTemplate x:DataType="books:RecommendedBook">
                                   <Border FlexLayout.Basis="48%"
                                           Margin="0,0,0,12"
                                           Background="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}"
                                           Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                                           StrokeShape="RoundRectangle 10"
                                           SemanticProperties.Description="{Binding Title, StringFormat='Open {0} on Amazon.'}">
                                       <Border.GestureRecognizers>
                                           <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=OpenBookCommand}"
                                                                 CommandParameter="{Binding .}" />
                                       </Border.GestureRecognizers>
                                       <Grid RowDefinitions="150,Auto">
                                           <Image Source="{Binding ImageName}"
                                                  Aspect="AspectFill"
                                                  HeightRequest="150"
                                                  SemanticProperties.Description="{Binding Title, StringFormat='{0} book artwork'}" />
                                           <VerticalStackLayout Grid.Row="1" Padding="10,9" Spacing="3">
                                               <Label Text="{Binding Title}"
                                                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                                      FontAttributes="Bold"
                                                      FontSize="13"
                                                      LineBreakMode="TailTruncation"
                                                      MaxLines="2" />
                                               <Label Text="{Binding Author}"
                                                      TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                      FontSize="11"
                                                      LineBreakMode="TailTruncation"
                                                      MaxLines="2" />
                                               <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceXs}">
                                                   <Label Text="View on Amazon"
                                                          TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                                                          FontAttributes="Bold"
                                                          FontSize="11" />
                                                   <Label Grid.Column="1"
                                                          Text="&#xf35d;"
                                                          FontFamily="FontAwesomeSolid"
                                                          TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                                                          FontSize="11"
                                                          SemanticProperties.Description="Opens externally" />
                                               </Grid>
                                           </VerticalStackLayout>
                                       </Grid>
                                   </Border>
                               </DataTemplate>
                           </BindableLayout.ItemTemplate>
                       </FlexLayout>
                       <Border Padding="{StaticResource CardPaddingCompact}"
                               Background="{AppThemeBinding Light={StaticResource SurfaceInsetLight}, Dark={StaticResource SurfaceInsetDark}}"
                               Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                               StrokeShape="RoundRectangle 10">
                           <VerticalStackLayout Spacing="3">
                               <Label Text="Affiliate disclosure"
                                      TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                      FontAttributes="Bold"
                                      FontSize="12" />
                               <Label Text="These Amazon links are affiliate links. We may earn a small commission at no extra cost to you, which helps support this free calculator."
                                      TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                      FontSize="12"
                                      LineHeight="1.25" />
                           </VerticalStackLayout>
                       </Border>
                   </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
    </shimmer:SfShimmer>
</ContentPage>