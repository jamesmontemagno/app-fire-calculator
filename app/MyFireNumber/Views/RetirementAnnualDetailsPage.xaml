<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             x:Class="MyFireNumber.Views.RetirementAnnualDetailsPage"
             x:DataType="viewModels:RetirementAnnualDetailsViewModel"
             Title="Annual Cash Flow"
             Shell.NavBarIsVisible="True"
             Shell.TabBarIsVisible="False"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">
    <Grid Padding="20,16,20,0" RowDefinitions="Auto,*" RowSpacing="14">
        <VerticalStackLayout Spacing="4">
            <Label Text="Annual cash-flow details"
                   FontAttributes="Bold"
                   FontSize="28"
                   TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Tap a year to review income, expenses, withdrawals, and account balances."
                   FontSize="14"
                   LineHeight="1.3"
                   TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        AutomationId="AnnualCashFlowList"
                        ItemsSource="{Binding Years}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:RetirementAnnualDetailItem">
                    <Border Margin="0,0,0,10"
                            Padding="16"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                            Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                            StrokeShape="RoundRectangle 12"
                            SemanticProperties.Description="{Binding ExpansionDescription}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" />
                                    <Label Text="{Binding BalanceText, StringFormat='Ending balance {0}'}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding ExpansionGlyph}"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" />
                            </Grid>

                            <VerticalStackLayout Grid.Row="1"
                                                 IsVisible="{Binding IsExpanded}"
                                                 Spacing="12">
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                    <Border Padding="10" StrokeThickness="0" Background="{AppThemeBinding Light=#EAF4EC, Dark=#29483B}" StrokeShape="RoundRectangle 8">
                                        <VerticalStackLayout Spacing="2"><Label Text="Income" FontSize="12" /><Label Text="{Binding IncomeText}" FontAttributes="Bold" /></VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10" StrokeThickness="0" Background="{AppThemeBinding Light=#FFF1E7, Dark=#493225}" StrokeShape="RoundRectangle 8">
                                        <VerticalStackLayout Spacing="2"><Label Text="Expenses" FontSize="12" /><Label Text="{Binding ExpensesText}" FontAttributes="Bold" /></VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="10" StrokeThickness="0" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" StrokeShape="RoundRectangle 8">
                                        <VerticalStackLayout Spacing="2"><Label Text="Annual surplus or shortfall" FontSize="12" /><Label Text="{Binding SurplusText}" FontAttributes="Bold" /></VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Income and withdrawals" FontAttributes="Bold" />
                                    <Label Text="{Binding IncomeBreakdown}" FontSize="13" LineHeight="1.3" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Expenses" FontAttributes="Bold" />
                                    <Label Text="{Binding ExpenseBreakdown}" FontSize="13" LineHeight="1.3" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Account balances" FontAttributes="Bold" />
                                    <Label Text="{Binding AccountBalanceBreakdown}" FontSize="13" LineHeight="1.3" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
