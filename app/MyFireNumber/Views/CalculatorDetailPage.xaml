                                                </Grid>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <VerticalStackLayout Spacing="3"><Label Text="Withdrawal rate (%)" FontAttributes="Bold" FontSize="12" /><Entry Text="{Binding WithdrawalRateText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#FFFFFF, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="4" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Annual account withdrawal rate percentage" /></VerticalStackLayout>
