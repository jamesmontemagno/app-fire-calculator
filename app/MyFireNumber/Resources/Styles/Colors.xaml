<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#2F6B57</Color>
    <Color x:Key="PrimaryDark">#CFE4D6</Color>
    <Color x:Key="PrimaryDarkText">#17352C</Color>
    <Color x:Key="Secondary">#E4F0E9</Color>
    <Color x:Key="SecondaryDarkText">#B9D1C2</Color>
    <Color x:Key="Tertiary">#9A4335</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#2F6B57</Color>
    <Color x:Key="MidnightBlue">#17352C</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!--
    Placeholder text. The grays above fail WCAG AA badly on this app's field
    backgrounds (Gray200 on the light field surface is 1.55:1), so placeholders
    use these instead. Light 5.0:1, dark 10.2:1 against the field backgrounds.
    -->
    <!--
    Switch "on" track/thumb pair. Light mode pairs a pale green track with the
    deep green thumb; dark mode mirrors that with a mid green track and the pale
    green thumb so the accent reads as green in both themes.
    -->
    <Color x:Key="SwitchTrackOnLight">#E4F0E9</Color>
    <Color x:Key="SwitchTrackOnDark">#3A6B57</Color>
    <Color x:Key="SwitchThumbOnLight">#2F6B57</Color>
    <Color x:Key="SwitchThumbOnDark">#CFE4D6</Color>

    <Color x:Key="PlaceholderLight">#587068</Color>
    <Color x:Key="PlaceholderDark">#B9D1C2</Color>


    <!--
    App theme tokens. Each entry carries an explicit light/dark pair. Names
    ending in Alt identify distinct near-duplicate variants that remain
    intentionally separate.
    -->
    <Color x:Key="TextAccentLight">#2F6B57</Color>
    <Color x:Key="TextAccentDark">#9ACCB3</Color>
    <Color x:Key="TextAccentStrongLight">#245744</Color>
    <Color x:Key="TextAccentStrongDark">#C8E7D5</Color>
    <Color x:Key="TextDangerLight">#7C352E</Color>
    <Color x:Key="TextDangerDark">#FFB9B1</Color>
    <Color x:Key="TextDangerAltLight">#A6473C</Color>
    <Color x:Key="TextDangerAltDark">#FFB9B1</Color>
    <Color x:Key="TextDangerDeepLight">#8A342B</Color>
    <Color x:Key="TextDangerDeepDark">#FFB9B1</Color>
    <Color x:Key="TextMutedAltLight">#587068</Color>
    <Color x:Key="TextMutedAltDark">#8EAA9B</Color>
    <Color x:Key="TextOnAccentLight">#FFFFFF</Color>
    <Color x:Key="TextOnAccentDark">#17352C</Color>
    <Color x:Key="TextPrimaryLight">#17352C</Color>
    <Color x:Key="TextPrimaryDark">#F2F7F3</Color>
    <Color x:Key="TextSecondaryLight">#425D54</Color>
    <Color x:Key="TextSecondaryDark">#B9D1C2</Color>
    <Color x:Key="TextSecondaryAltLight">#425D54</Color>
    <Color x:Key="TextSecondaryAltDark">#D8E8DE</Color>
    <Color x:Key="TextWarningLight">#6B3B12</Color>
    <Color x:Key="TextWarningDark">#FFE0BC</Color>
    <Color x:Key="TextWarningAltLight">#9A5C17</Color>
    <Color x:Key="TextWarningAltDark">#F2B56D</Color>

    <Color x:Key="SurfaceAccentSoftLight">#E4F0E9</Color>
    <Color x:Key="SurfaceAccentSoftDark">#29483B</Color>
    <Color x:Key="SurfaceAccentSoftWarmLight">#E6F0EA</Color>
    <Color x:Key="SurfaceAccentSoftWarmDark">#29483B</Color>
    <Color x:Key="SurfaceAccentTintDeepLight">#EAF4EC</Color>
    <Color x:Key="SurfaceAccentTintDeepDark">#1B3B2D</Color>
    <Color x:Key="SurfaceAccentTintFlatLight">#EAF4EC</Color>
    <Color x:Key="SurfaceAccentTintFlatDark">#15211C</Color>
    <Color x:Key="SurfaceAccentTintLight">#EAF4EC</Color>
    <Color x:Key="SurfaceAccentTintDark">#29483B</Color>
    <Color x:Key="SurfaceAccentTintPaleLight">#F4FAF6</Color>
    <Color x:Key="SurfaceAccentTintPaleDark">#182A22</Color>
    <Color x:Key="SurfaceCardLight">#FFFFFF</Color>
    <Color x:Key="SurfaceCardDark">#203129</Color>
    <Color x:Key="SurfaceCardFlatLight">#FFFFFF</Color>
    <Color x:Key="SurfaceCardFlatDark">#15211C</Color>
    <Color x:Key="SurfaceDangerLight">#FCE5E1</Color>
    <Color x:Key="SurfaceDangerDark">#4A2B2A</Color>
    <Color x:Key="SurfaceDangerAltLight">#FDEEEB</Color>
    <Color x:Key="SurfaceDangerAltDark">#4A2B2A</Color>
    <Color x:Key="SurfaceDangerSoftLight">#FFF7F5</Color>
    <Color x:Key="SurfaceDangerSoftDark">#2E201E</Color>
    <Color x:Key="SurfaceInfoLight">#EAF2FF</Color>
    <Color x:Key="SurfaceInfoDark">#1D3040</Color>
    <Color x:Key="SurfaceInfoSkyLight">#EAF5FC</Color>
    <Color x:Key="SurfaceInfoSkyDark">#1B3546</Color>
    <Color x:Key="SurfaceInfoTealLight">#E8F7F7</Color>
    <Color x:Key="SurfaceInfoTealDark">#19393C</Color>
    <Color x:Key="SurfaceInfoVioletLight">#EEF0FA</Color>
    <Color x:Key="SurfaceInfoVioletDark">#2A2E4C</Color>
    <Color x:Key="SurfaceInsetLight">#EDF2EE</Color>
    <Color x:Key="SurfaceInsetDark">#15211C</Color>
    <Color x:Key="SurfacePageLight">#F5F7F2</Color>
    <Color x:Key="SurfacePageDark">#15211C</Color>
    <Color x:Key="SurfaceWarningLight">#FFF4E8</Color>
    <Color x:Key="SurfaceWarningDark">#4A3323</Color>
    <Color x:Key="SurfaceWarningAltLight">#FFF1E7</Color>
    <Color x:Key="SurfaceWarningAltDark">#493225</Color>
    <Color x:Key="SurfaceWarningMutedLight">#FFF6E5</Color>
    <Color x:Key="SurfaceWarningMutedDark">#3A2F1B</Color>
