<?xml version="1.0" encoding="utf-8" ?>
<views:CalculatorPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:controls="clr-namespace:MyFireNumber.Views.Controls"
                          xmlns:views="clr-namespace:MyFireNumber.Views"
                          xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
                          xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
                          x:Class="MyFireNumber.Views.FireNumberPage"
                          x:DataType="viewModels:IFireNumberViewModel"
                          Title="{Binding Title}"
                          Shell.NavBarIsVisible="True"
                          Background="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}"
                          SafeAreaEdges="All">
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding SavePlanCommand}"
                     SemanticProperties.Description="Save the current calculator values as a plan.">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf0c7;" Size="18" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}"
                             Spacing="{StaticResource SpaceLg}">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="Restoring your local calculator draft." />
            <Border IsVisible="{Binding HasValidationMessage}"
                    Padding="14"
                    Background="{AppThemeBinding Light={StaticResource SurfaceWarningLight}, Dark={StaticResource SurfaceWarningDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarningLight}, Dark={StaticResource BorderWarningDark}}"
                    StrokeShape="RoundRectangle 8">
                <Label Text="{Binding ValidationMessage}"
                       TextColor="{AppThemeBinding Light={StaticResource TextWarningLight}, Dark={StaticResource TextWarningDark}}"
                       LineHeight="1.3" />
            </Border>

            <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                <controls:CalculatorInfoView IsVisible="{Binding IsStandardFire}"
                                             Title="What is Standard FIRE?"
                                             Summary="Calculate the portfolio needed for full financial independence using the classic 25x expenses rule."
                                             Details="Standard FIRE estimates when investments could cover annual expenses without earned income. It is a starting point, not a guarantee."
                                             IconGlyph="&#xf06d;" />
                <controls:CalculatorInfoView IsVisible="{Binding IsLeanFire}"
                                             Title="What is Lean FIRE?"
                                             Summary="Reach financial independence sooner by planning for a lower-cost, minimalist lifestyle."
                                             Details="Lean FIRE uses a smaller spending target, which may shorten the path but leaves less room for unexpected costs."
                                             IconGlyph="&#xf06c;" />
                <controls:CalculatorInfoView IsVisible="{Binding IsFatFire}"
                                             Title="What is Fat FIRE?"
                                             Summary="Plan for financial independence while maintaining a comfortable, higher-spending lifestyle."
                                             Details="Fat FIRE pairs a larger portfolio target with more flexibility for lifestyle choices and unexpected costs."
                                             IconGlyph="&#xf219;" />
                <Border IsVisible="{Binding IsLeanFire}"
                        Padding="{StaticResource CardPaddingCompact}"
                        Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding LeanStatusText}" FontAttributes="Bold" />
                        <Label Text="{Binding LeanGuidanceText}" Style="{StaticResource CalculatorSupportingText}" />
                    </VerticalStackLayout>
                </Border>
                <Border IsVisible="{Binding IsFatFire}"
                        Padding="{StaticResource CardPaddingCompact}"
                        Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding FatStatusText}" FontAttributes="Bold" />
                        <Label Text="{Binding FatGuidanceText}" Style="{StaticResource CalculatorSupportingText}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Border Padding="{StaticResource CardPadding}"
                    Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                        <Label Text="Your starting point" Style="{StaticResource CalculatorSectionHeading}" />
                        <Button Grid.Column="1"
                                Text="Reset"
                                Command="{Binding ResetDefaultsCommand}"
                                Background="{StaticResource Secondary}"
                                TextColor="{StaticResource PrimaryDarkText}"
                                FontSize="12"
                                SemanticProperties.Description="Reset this calculator to its defaults." />
                    </Grid>
                    <controls:PeriodToggleView />
                    <VerticalStackLayout IsVisible="{Binding IsStandardFire}" Spacing="4">
                        <controls:FieldHelpView Header="Quick preset"
                                                HelpText="A preset replaces all assumptions with a common starting point. You can still edit every value below." />
                        <Picker Title="Choose a starting point"
                                ItemsSource="{Binding StandardFirePresets}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedPreset}"
                                Background="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}"
                                SemanticProperties.Description="Choose a complete Standard FIRE preset." />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="{StaticResource SpaceMd}"
                          RowSpacing="{StaticResource SpaceMd}">
                        <controls:NumericInputView Header="Current age"
                                                   HelpText="Your age today, in years."
                                                   Placeholder="30"
                                                   Text="{Binding CurrentAgeText}" />
                        <controls:NumericInputView Grid.Column="1"
                                                   Header="Current savings"
                                                   HelpText="Invested assets available for this goal, in dollars."
                                                   Placeholder="100000"
                                                   Text="{Binding CurrentSavingsText}" />
                        <controls:NumericInputView Grid.Row="1"
                                                   Header="Contribution"
                                                   HelpText="How much you add to investments, in dollars."
                                                   Placeholder="24000"
                                                   Text="{Binding AnnualContributionText}" PeriodSuffix="{Binding DisplayPeriodSuffix}" />
                        <controls:NumericInputView Grid.Row="1"
                                                   Grid.Column="1"
                                                   Header="Income"
                                                   HelpText="Income after taxes, used to calculate your savings rate."
                                                   Placeholder="72000"
                                                   Text="{Binding AnnualIncomeText}" PeriodSuffix="{Binding DisplayPeriodSuffix}" />
                        <controls:NumericInputView Grid.Row="2"
                                                   Grid.ColumnSpan="2"
                                                   Header="Expenses"
                                                   HelpText="Estimated spending after leaving full-time work."
                                                   Placeholder="48000"
                                                   Text="{Binding AnnualExpensesText}" PeriodSuffix="{Binding DisplayPeriodSuffix}" />
                    </Grid>
                    <controls:AdvancedAssumptionsExpander>
                        <VerticalStackLayout Margin="0,12,0,0" Spacing="{StaticResource SpaceMd}">
                            <controls:NumericInputView Header="Retirement age"
                                                       HelpText="The age you would like to reach financial independence."
                                                       Placeholder="55"
                                                       Text="{Binding RetirementAgeText}" />
                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="{StaticResource SpaceMd}"
                                  RowSpacing="{StaticResource SpaceMd}">
                                <controls:PercentageInputView Header="Expected return"
                                                              HelpText="Expected average annual investment return before inflation."
                                                              Placeholder="7"
                                                              Minimum="0"
                                                              Maximum="15"
                                                              Text="{Binding ExpectedReturnText}" />
                                <controls:PercentageInputView Grid.Column="1"
                                                              Header="Inflation"
                                                              HelpText="Expected annual increase in the cost of living."
                                                              Placeholder="3"
                                                              Minimum="0"
                                                              Maximum="10"
                                                              Text="{Binding InflationRateText}" />
                                <controls:PercentageInputView Grid.Row="1"
                                                              Grid.ColumnSpan="2"
                                                              Header="Safe withdrawal rate"
                                                              HelpText="First-year percentage withdrawn from the portfolio. This is an assumption, not a promise."
                                                              Placeholder="4"
                                                              Minimum="2"
                                                              Maximum="6"
                                                              Text="{Binding WithdrawalRateText}" />
                            </Grid>
                        </VerticalStackLayout>
                    </controls:AdvancedAssumptionsExpander>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                <Label Text="{Binding OutlookTitle}" Style="{StaticResource CalculatorSectionHeading}" />
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="{StaticResource SpaceSm}"
                      RowSpacing="{StaticResource SpaceSm}">
                    <Border Padding="{StaticResource CardPaddingCompact}" Background="{AppThemeBinding Light={StaticResource SurfaceAccentSoftLight}, Dark={StaticResource SurfaceAccentSoftDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="{Binding FireNumberLabel}" FontSize="12" /><Label Text="{Binding FireNumberText}" FontAttributes="Bold" FontSize="22" /></VerticalStackLayout></Border>
                    <Border Grid.Column="1" Padding="{StaticResource CardPaddingCompact}" Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="{Binding YearsToFireLabel}" FontSize="12" /><Label Text="{Binding YearsToFireText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                    <Border Grid.Row="1" Padding="{StaticResource CardPaddingCompact}" Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="FIRE age" FontSize="12" /><Label Text="{Binding FireAgeText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                    <Border Grid.Row="1" Grid.Column="1" Padding="{StaticResource CardPaddingCompact}" Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="Savings rate" FontSize="12" /><Label Text="{Binding SavingsRateText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="{StaticResource CardPaddingCompact}" Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="Monthly contribution" FontSize="12" /><Label Text="{Binding MonthlyContributionText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                </Grid>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Target-age check"
                           FontAttributes="Bold" />
                    <Label Text="{Binding RetirementGoalText}"
                           Style="{StaticResource CalculatorSupportingText}"
                           SemanticProperties.Description="{Binding RetirementGoalText}" />
                </VerticalStackLayout>
                <ProgressBar Progress="{Binding ProgressToFire}" />
                <Label Text="{Binding ProgressDescription}" Style="{StaticResource CalculatorSupportingText}" />
                <Label Text="{Binding ProjectionSummary}" Style="{StaticResource CalculatorSupportingText}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                <Label Text="{Binding ProjectionTitle}" Style="{StaticResource CalculatorSectionHeading}" />
                <lvc:CartesianChart Series="{Binding ProjectionSeries}"
                                    XAxes="{Binding ProjectionXAxes}"
                                    AnimationsSpeed="{Binding ChartAnimationsSpeed}"
                                    HeightRequest="300"
                                    SemanticProperties.Description="{Binding ProjectionChartDescription}" />
                <Label Text="{Binding ProjectionSummary}" Style="{StaticResource CalculatorSupportingText}" />
            </VerticalStackLayout>

            <Border Padding="{StaticResource CardPadding}"
                    Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                    <Label Text="Save or export this plan" Style="{StaticResource CalculatorSectionHeading}" />
                    <Entry Text="{Binding PlanNameText}"
                           Placeholder="{Binding PlanNamePlaceholder}"
                           Background="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}"
                           SemanticProperties.Description="{Binding PlanNameDescription}" />
                    <Button Text="{Binding SavePlanActionText}"
                            Command="{Binding SavePlanCommand}"
                            SemanticProperties.Description="{Binding SavePlanActionDescription}" />
                    <Button Text="Export to Excel"
                            Command="{Binding ExportCommand}"
                            Background="{StaticResource Secondary}"
                            TextColor="{StaticResource PrimaryDarkText}"
                            SemanticProperties.Description="{Binding ExportDescription}" />
                    <Label IsVisible="{Binding HasPlanStatusMessage}" Text="{Binding PlanStatusMessage}" Style="{StaticResource CalculatorSupportingText}" />
                    <Label IsVisible="{Binding HasExportStatusMessage}" Text="{Binding ExportStatusMessage}" Style="{StaticResource CalculatorSupportingText}" />
                    <controls:EducationalDisclaimerView />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</views:CalculatorPageBase>
