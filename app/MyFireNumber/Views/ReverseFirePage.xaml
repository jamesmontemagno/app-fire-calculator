<?xml version="1.0" encoding="utf-8" ?>
<views:CalculatorPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyFireNumber.Views.Controls"
             xmlns:views="clr-namespace:MyFireNumber.Views"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="MyFireNumber.Views.ReverseFirePage"
             x:DataType="viewModels:ReverseFireViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save"
                     Order="Primary"
                     Priority="0"
                     Command="{Binding SavePlanAndCloseCommand}"
                     SemanticProperties.Description="{Binding SavePlanActionDescription}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid"
                                 Glyph="&#xf0c7;"
                                 Color="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                 Size="18" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,32" Spacing="18">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="Restoring your local calculator draft." />

            <Border IsVisible="{Binding HasValidationMessage}"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFF4E8, Dark=#4A3323}"
                    Stroke="{AppThemeBinding Light=#C97727, Dark=#F2B56D}"
                    StrokeShape="RoundRectangle 8">
                <Label Text="{Binding ValidationMessage}"
                       TextColor="{AppThemeBinding Light=#6B3B12, Dark=#FFE0BC}"
                       LineHeight="1.3" />
            </Border>

                <Border Padding="16" Background="{AppThemeBinding Light=#E8F7F7, Dark=#19393C}" Stroke="{AppThemeBinding Light=#9CD8DA, Dark=#39777B}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="&#xf2f1;" FontFamily="FontAwesomeSolid" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#167077, Dark=#8ED7D8}" SemanticProperties.Description="Reverse FIRE explanation" />
                            <Label Grid.Column="1" Text="How Reverse FIRE works" TextColor="{AppThemeBinding Light=#11545A, Dark=#D5FAFA}" FontAttributes="Bold" FontSize="20" />
                        </Grid>
                        <Label Text="Set your target FIRE age and work backward to see the savings needed to reach your portfolio goal." TextColor="{AppThemeBinding Light=#21686D, Dark=#BCEBEB}" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}" Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="&#xf201;" FontFamily="FontAwesomeSolid" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#167077, Dark=#8ED7D8}" SemanticProperties.Description="Reverse FIRE goals" />
                            <Label Grid.Column="1" Text="Your FIRE goal" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" FontAttributes="Bold" FontSize="20" />
                            <Button Grid.Column="2" Text="Reset" Command="{Binding ResetDefaultsCommand}" Background="#E3F3F3" TextColor="#11545A" FontSize="12" MinimumWidthRequest="86" SemanticProperties.Description="Reset Reverse FIRE values to their defaults.">
                                <Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf01e;" Color="#11545A" Size="12" /></Button.ImageSource>
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <VerticalStackLayout Spacing="4"><Label Text="Current age" FontAttributes="Bold" /><Entry Text="{Binding CurrentAgeText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="30" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Current age in years" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Target FIRE age" FontAttributes="Bold" /><Entry Text="{Binding RetirementAgeText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="55" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Target age to reach financial independence" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4"><Label Text="Current savings" FontAttributes="Bold" /><Entry Text="{Binding CurrentSavingsText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="100000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Current invested savings in dollars" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="4"><Label Text="Annual retirement expenses" FontAttributes="Bold" /><Entry Text="{Binding AnnualExpensesText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="48000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Annual retirement expenses in dollars" /></VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4"><Label Text="Return (%)" FontAttributes="Bold" /><Entry Text="{Binding ExpectedReturnText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="7" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Expected annual return percentage" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Inflation (%)" FontAttributes="Bold" /><Entry Text="{Binding InflationRateText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="3" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Annual inflation percentage" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4"><Label Text="Withdrawal (%)" FontAttributes="Bold" /><Entry Text="{Binding WithdrawalRateText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="4" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Safe withdrawal rate percentage" /></VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}" Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding ReverseStatusText}" TextColor="{AppThemeBinding Light=#11545A, Dark=#BCEBEB}" FontAttributes="Bold" FontSize="18" LineHeight="1.3" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border Padding="12" Background="{AppThemeBinding Light=#E8F7F7, Dark=#19393C}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="Monthly savings needed" FontSize="12" TextColor="{AppThemeBinding Light=#21686D, Dark=#BCEBEB}" /><Label Text="{Binding ReverseRequiredMonthlySavingsText}" FontAttributes="Bold" FontSize="22" /></VerticalStackLayout></Border>
                            <Border Grid.Column="1" Padding="12" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="Annual savings needed" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" /><Label Text="{Binding ReverseRequiredAnnualSavingsText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                            <Border Grid.Row="1" Padding="12" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="Years to FIRE" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" /><Label Text="{Binding ReverseYearsText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                            <Border Grid.Row="1" Grid.Column="1" Padding="12" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="Current savings will grow to" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" /><Label Text="{Binding ReverseCurrentGrowthText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                        </Grid>
                        <Button Text="Export to Excel" Command="{Binding ExportCommand}" Background="#167077" TextColor="#FFFFFF" SemanticProperties.Description="Create a Reverse FIRE workbook on this device and open the native share sheet."><Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf56d;" Color="#FFFFFF" Size="14" /></Button.ImageSource></Button>
                        <Label IsVisible="{Binding HasExportStatusMessage}" Text="{Binding ExportStatusMessage}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" FontSize="13" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}" Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Label Text="&#xf15c;" FontFamily="FontAwesomeSolid" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#167077, Dark=#8ED7D8}" SemanticProperties.Description="Saved Reverse FIRE plan" /><Label Grid.Column="1" Text="Save this Reverse FIRE scenario" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" FontAttributes="Bold" FontSize="20" /></Grid>
                        <Label Text="Plan name" FontAttributes="Bold" />
                        <Entry Text="{Binding PlanNameText, Mode=TwoWay}" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="My Reverse FIRE Plan" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Name for this saved Reverse FIRE plan" />
                        <Button Text="{Binding SavePlanActionText}" Command="{Binding SavePlanCommand}" SemanticProperties.Description="{Binding SavePlanActionDescription}" Background="#167077" TextColor="#FFFFFF"><Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf0c7;" Color="#FFFFFF" Size="14" /></Button.ImageSource></Button>
                        <Label IsVisible="{Binding HasPlanStatusMessage}" Text="{Binding PlanStatusMessage}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" FontSize="13" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}" Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Label Text="&#xf201;" FontFamily="FontAwesomeSolid" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#167077, Dark=#8ED7D8}" SemanticProperties.Description="Reverse FIRE projection" /><Label Grid.Column="1" Text="Portfolio projection" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" FontAttributes="Bold" FontSize="20" /></Grid>
                        <lvc:CartesianChart Series="{Binding ProjectionSeries}" XAxes="{Binding ProjectionXAxes}" AnimationsSpeed="{Binding ChartAnimationsSpeed}" HeightRequest="300" SemanticProperties.Description="{Binding ProjectionChartDescription}" />
                        <Label Text="{Binding ReverseProjectionSummary}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" FontSize="13" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>
                <controls:EducationalDisclaimerView />
        </VerticalStackLayout>
    </ScrollView>
</views:CalculatorPageBase>
