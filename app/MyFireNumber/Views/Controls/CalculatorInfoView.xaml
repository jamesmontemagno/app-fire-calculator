<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFireNumber.Views.Controls.CalculatorInfoView"
             x:Name="Root">
    <Border Padding="{StaticResource CardPadding}"
            Background="{AppThemeBinding Light={StaticResource SurfaceAccentTintDeepLight}, Dark={StaticResource SurfaceAccentTintDeepDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderAccentSoftLight}, Dark={StaticResource BorderAccentSoftDark}}"
            StrokeShape="RoundRectangle 8">
        <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                <Label Text="{Binding IconGlyph, Source={x:Reference Root}}"
                       FontFamily="FontAwesomeSolid"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextAccentAltLight}, Dark={StaticResource TextAccentAltDark}}"
                       SemanticProperties.Description="Calculator information" />
                <Label Grid.Column="1"
                       Text="{Binding Title, Source={x:Reference Root}}"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       FontAttributes="Bold"
                       FontSize="20"
                       SemanticProperties.HeadingLevel="Level2" />
            </Grid>
            <Label Text="{Binding Summary, Source={x:Reference Root}}"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                   LineHeight="1.3" />
            <Button x:Name="DetailsButton"
                    Text="Learn more"
                    Clicked="OnDetailsClicked"
                    HorizontalOptions="Start"
                    Padding="0,6"
                    Background="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource TextAccentAltLight}, Dark={StaticResource TextAccentAltDark}}"
                    FontAttributes="Bold"
                    SemanticProperties.Description="Show more information about this calculator" />
            <Label x:Name="DetailsLabel"
                   IsVisible="False"
                   Text="{Binding Details, Source={x:Reference Root}}"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                   FontSize="13"
                   LineHeight="1.35" />
        </VerticalStackLayout>
    </Border>
</ContentView>
