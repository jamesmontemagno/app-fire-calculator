<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:catalog="clr-namespace:MyFireNumber.Core.Calculators;assembly=MyFireNumber.Core"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             x:Class="MyFireNumber.Views.CalculatorsPage"
             x:DataType="viewModels:CalculatorCatalogViewModel"
             Title="Calculators"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">

    <Grid Padding="20,16" RowDefinitions="Auto,*" RowSpacing="16">
        <SearchBar Placeholder="Search calculators"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   Background="#FFFFFF"
                   TextColor="#17352C"
                   PlaceholderColor="#587068"
                   SemanticProperties.Description="Search available calculators" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding FilteredCalculators}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="catalog:CalculatorDefinition">
                    <Border Margin="0,0,0,10"
                            Padding="16"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                            Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                            StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}"
                                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                       FontAttributes="Bold"
                                       FontSize="18" />
                                <Label Text="{Binding Summary}"
                                       TextColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}"
                                       FontSize="13" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Open"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CalculatorCatalogViewModel}}, Path=OpenCalculatorCommand}"
                                    CommandParameter="{Binding .}"
                                    Background="#2F6B57"
                                    TextColor="#FFFFFF"
                                    FontSize="12"
                                    MinimumWidthRequest="78">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf061;" Color="#FFFFFF" Size="12" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                  <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                      <Label Text="&#xf002;"
                          Style="{StaticResource IconGlyph}"
                          TextColor="{AppThemeBinding Light=#326B57, Dark=#9ACCB3}"
                          FontSize="28"
                           SemanticProperties.Description="Search" />
                      <Label Text="No calculators match that search."
                          HorizontalTextAlignment="Center"
                          VerticalTextAlignment="Center" />
                  </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>