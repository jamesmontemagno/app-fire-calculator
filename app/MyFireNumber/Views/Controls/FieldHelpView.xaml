<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFireNumber.Views.Controls.FieldHelpView"
             x:Name="Root">
    <Grid RowDefinitions="Auto,Auto"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="4"
          RowSpacing="4">
        <Label Text="{Binding Header, Source={x:Reference Root}}"
               FontAttributes="Bold"
               VerticalTextAlignment="Center"
               SemanticProperties.HeadingLevel="Level3" />
        <Button Grid.Column="1"
                x:Name="InfoButton"
                Text="Info"
                Style="{StaticResource FieldHelpInfoButton}"
                Clicked="OnInfoClicked"
                SemanticProperties.Description="Show help for this field" />
        <Label Grid.Row="1"
               Grid.ColumnSpan="2"
               x:Name="HelpTextLabel"
               IsVisible="False"
               Text="{Binding HelpText, Source={x:Reference Root}}"
               Style="{StaticResource CalculatorSupportingText}"
               SemanticProperties.Description="{Binding HelpText, Source={x:Reference Root}}" />
    </Grid>
</ContentView>
