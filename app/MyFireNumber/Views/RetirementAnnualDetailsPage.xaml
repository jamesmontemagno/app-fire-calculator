<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             x:Class="MyFireNumber.Views.RetirementAnnualDetailsPage"
             x:DataType="viewModels:RetirementAnnualDetailsViewModel"
             Title="Annual Cash Flow"
             Shell.NavBarIsVisible="True"
             Shell.TabBarIsVisible="False"
             Background="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}"
             SafeAreaEdges="All">
    <Grid Padding="{StaticResource PagePaddingCompact}" RowDefinitions="Auto,*" RowSpacing="{StaticResource SpaceMd}">
        <VerticalStackLayout Spacing="4">
            <Label Text="Annual cash-flow details"
                   FontAttributes="Bold"
                   FontSize="28"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Tap a year to review income, expenses, withdrawals, and account balances."
                   FontSize="14"
                   LineHeight="1.3"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        AutomationId="AnnualCashFlowList"
                        ItemsSource="{Binding Years}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:RetirementAnnualDetailItem">
                    <Border Margin="0,0,0,10"
                            Padding="{StaticResource CardPadding}"
                            Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 12"
                            SemanticProperties.Description="{Binding ExpansionDescription}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceMd}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding BalanceText, StringFormat='Ending balance {0}'}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding ExpansionGlyph}"
                                       FontFamily="FontAwesomeSolid"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}" />
                            </Grid>

                            <VerticalStackLayout Grid.Row="1"
                                                 IsVisible="{Binding IsExpanded}"
                                                 Spacing="{StaticResource SpaceMd}">
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}" RowSpacing="{StaticResource SpaceSm}">
                                    <Border Padding="10" StrokeThickness="0" Background="{AppThemeBinding Light={StaticResource SurfaceAccentTintLight}, Dark={StaticResource SurfaceAccentTintDark}}" StrokeShape="RoundRectangle 8">
                                        <VerticalStackLayout Spacing="2"><Label Text="Income" FontSize="12" /><Label Text="{Binding IncomeText}" FontAttributes="Bold" /></VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10" StrokeThickness="0" Background="{AppThemeBinding Light={StaticResource SurfaceWarningAltLight}, Dark={StaticResource SurfaceWarningAltDark}}" StrokeShape="RoundRectangle 8">
                                        <VerticalStackLayout Spacing="2"><Label Text="Expenses" FontSize="12" /><Label Text="{Binding ExpensesText}" FontAttributes="Bold" /></VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="10" StrokeThickness="0" Background="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}" StrokeShape="RoundRectangle 8">
                                        <VerticalStackLayout Spacing="2"><Label Text="Annual surplus or shortfall" FontSize="12" /><Label Text="{Binding SurplusText}" FontAttributes="Bold" /></VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Income and withdrawals" FontAttributes="Bold" />
                                    <Label Text="{Binding IncomeBreakdown}" FontSize="13" LineHeight="1.3" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Expenses" FontAttributes="Bold" />
                                    <Label Text="{Binding ExpenseBreakdown}" FontSize="13" LineHeight="1.3" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Account balances" FontAttributes="Bold" />
                                    <Label Text="{Binding AccountBalanceBreakdown}" FontSize="13" LineHeight="1.3" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
