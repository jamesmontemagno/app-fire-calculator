<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             x:Class="MyFireNumber.Views.CalculatorDetailPage"
             x:DataType="viewModels:CalculatorDetailViewModel"
             Title="Calculator"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="18">
                <Label Text="{Binding Title}"
                       TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                       FontAttributes="Bold"
                       FontSize="30"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding Summary}"
                       TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                       FontSize="16"
                       LineHeight="1.3" />
                <Border Padding="18"
                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}"
                        Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}"
                        StrokeShape="RoundRectangle 8">
                    <Label Text="Calculator inputs, live results, plans, and export are being connected in the next vertical slice."
                           TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}"
                           LineHeight="1.3" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>