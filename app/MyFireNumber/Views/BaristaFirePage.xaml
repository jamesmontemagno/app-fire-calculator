<?xml version="1.0" encoding="utf-8" ?>
<views:CalculatorPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyFireNumber.Views.Controls"
             xmlns:views="clr-namespace:MyFireNumber.Views"
             xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="MyFireNumber.Views.BaristaFirePage"
             x:DataType="viewModels:BaristaFireViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save"
                     Order="Primary"
                     Priority="0"
                     Command="{Binding SavePlanAndCloseCommand}"
                     SemanticProperties.Description="{Binding SavePlanActionDescription}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid"
                                 Glyph="&#xf0c7;"
                                 Color="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}"
                                 Size="18" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,32" Spacing="18">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="Restoring your local calculator draft." />

            <Border IsVisible="{Binding HasValidationMessage}"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFF4E8, Dark=#4A3323}"
                    Stroke="{AppThemeBinding Light=#C97727, Dark=#F2B56D}"
                    StrokeShape="RoundRectangle 8">
                <Label Text="{Binding ValidationMessage}"
                       TextColor="{AppThemeBinding Light=#6B3B12, Dark=#FFE0BC}"
                       LineHeight="1.3" />
            </Border>

                <controls:CalculatorInfoView Title="What is Barista FIRE?"
                                             Summary="Blend part-time income with portfolio withdrawals to leave full-time work earlier."
                                             Details="Barista FIRE means investing enough to cover most expenses while part-time or lower-stress work covers the remaining gap and may provide benefits such as health insurance. It offers a smaller portfolio target than full FIRE, but depends on continued earned income. It may fit if you want better work-life balance rather than stopping work completely."
                                             IconGlyph="&#xf0f4;" />

                <Border Padding="16" Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}" Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="&#xf1ec;" FontFamily="FontAwesomeSolid" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#9A5C17, Dark=#F2B56D}" SemanticProperties.Description="Barista FIRE assumptions" />
                            <Label Grid.Column="1" Text="Your Barista FIRE assumptions" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" FontAttributes="Bold" FontSize="20" />
                            <Button Grid.Column="2" Text="Reset" Command="{Binding ResetDefaultsCommand}" Background="#FFF0DD" TextColor="#7A4A1A" FontSize="12" MinimumWidthRequest="86" SemanticProperties.Description="Reset Barista FIRE values to their defaults.">
                                <Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf01e;" Color="#7A4A1A" Size="12" /></Button.ImageSource>
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <VerticalStackLayout Spacing="4"><Label Text="Current age" FontAttributes="Bold" /><Entry Text="{Binding CurrentAgeText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="30" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Current age in years" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Annual contribution" FontAttributes="Bold" /><Entry Text="{Binding AnnualContributionText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="24000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Annual contribution in dollars" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4"><Label Text="Current savings" FontAttributes="Bold" /><Entry Text="{Binding CurrentSavingsText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="100000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Current invested savings in dollars" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Spacing="4"><Label Text="Annual expenses" FontAttributes="Bold" /><Entry Text="{Binding AnnualExpensesText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="48000" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Annual expenses in dollars" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4"><Label Text="Part-time annual income" FontAttributes="Bold" /><Entry Text="{Binding PartTimeAnnualIncomeText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#FFF4E8, Dark=#4A3323}" TextColor="{AppThemeBinding Light=#6B3B12, Dark=#FFE0BC}" Placeholder="20000" PlaceholderColor="{AppThemeBinding Light=#9A6C3E, Dark=#F2B56D}" SemanticProperties.Description="Expected annual income from part-time work in dollars" /></VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4"><Label Text="Return (%)" FontAttributes="Bold" /><Entry Text="{Binding ExpectedReturnText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="7" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Expected annual return percentage" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Inflation (%)" FontAttributes="Bold" /><Entry Text="{Binding InflationRateText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="3" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Annual inflation percentage" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4"><Label Text="Withdrawal (%)" FontAttributes="Bold" /><Entry Text="{Binding WithdrawalRateText, Mode=TwoWay}" Keyboard="Numeric" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="4" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Safe withdrawal rate percentage" /></VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}" Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Your Barista FIRE outlook" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" FontAttributes="Bold" FontSize="20" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border Padding="12" Background="{AppThemeBinding Light=#FFF4E8, Dark=#4A3323}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="Barista FIRE Number" FontSize="12" TextColor="{AppThemeBinding Light=#7A4A1A, Dark=#F4D0A8}" /><Label Text="{Binding BaristaNumberText}" FontAttributes="Bold" FontSize="22" /></VerticalStackLayout></Border>
                            <Border Grid.Column="1" Padding="12" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="Full FIRE Number" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" /><Label Text="{Binding FullFireNumberText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="12" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" StrokeThickness="0" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="2"><Label Text="Years to Barista FIRE" FontSize="12" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" /><Label Text="{Binding BaristaYearsText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout></Border>
                        </Grid>
                        <Label Text="{Binding BaristaReductionText}" TextColor="{AppThemeBinding Light=#7A4A1A, Dark=#F4D0A8}" FontAttributes="Bold" />
                        <Label Text="{Binding BaristaProgressDescription}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" FontSize="13" />
                        <Button Text="Export to Excel" Command="{Binding ExportCommand}" Background="#9A5C17" TextColor="#FFFFFF" SemanticProperties.Description="Create a Barista FIRE workbook on this device and open the native share sheet.">
                            <Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf56d;" Color="#FFFFFF" Size="14" /></Button.ImageSource>
                        </Button>
                        <Label IsVisible="{Binding HasExportStatusMessage}" Text="{Binding ExportStatusMessage}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" FontSize="13" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}" Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="&#xf15c;" FontFamily="FontAwesomeSolid" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#9A5C17, Dark=#F2B56D}" SemanticProperties.Description="Saved Barista FIRE plan" />
                            <Label Grid.Column="1" Text="Save this Barista FIRE scenario" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" FontAttributes="Bold" FontSize="20" />
                        </Grid>
                        <Label Text="Plan name" FontAttributes="Bold" />
                        <Entry Text="{Binding PlanNameText, Mode=TwoWay}" Background="{AppThemeBinding Light=#F5F7F2, Dark=#15211C}" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" Placeholder="My Barista FIRE Plan" PlaceholderColor="{AppThemeBinding Light=#587068, Dark=#B9D1C2}" SemanticProperties.Description="Name for this saved Barista FIRE plan" />
                        <Button Text="{Binding SavePlanActionText}" Command="{Binding SavePlanCommand}" SemanticProperties.Description="{Binding SavePlanActionDescription}" Background="#9A5C17" TextColor="#FFFFFF">
                            <Button.ImageSource><FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf0c7;" Color="#FFFFFF" Size="14" /></Button.ImageSource>
                        </Button>
                        <Label IsVisible="{Binding HasPlanStatusMessage}" Text="{Binding PlanStatusMessage}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" FontSize="13" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" Background="{AppThemeBinding Light=#FFFFFF, Dark=#203129}" Stroke="{AppThemeBinding Light=#D7DED8, Dark=#365244}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="&#xf201;" FontFamily="FontAwesomeSolid" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#9A5C17, Dark=#F2B56D}" SemanticProperties.Description="Barista FIRE projection" />
                            <Label Grid.Column="1" Text="Barista FIRE projection" TextColor="{AppThemeBinding Light=#17352C, Dark=#F2F7F3}" FontAttributes="Bold" FontSize="20" />
                        </Grid>
                        <lvc:CartesianChart Series="{Binding ProjectionSeries}" XAxes="{Binding ProjectionXAxes}" AnimationsSpeed="{Binding ChartAnimationsSpeed}" HeightRequest="300" SemanticProperties.Description="{Binding ProjectionChartDescription}" />
                        <Label Text="{Binding BaristaProjectionSummary}" TextColor="{AppThemeBinding Light=#425D54, Dark=#B9D1C2}" FontSize="13" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>
                <controls:EducationalDisclaimerView />
        </VerticalStackLayout>
    </ScrollView>
</views:CalculatorPageBase>
