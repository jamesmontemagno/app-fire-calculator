<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MyFireNumber.Views.Controls"
             x:Class="MyFireNumber.Views.Controls.PercentageInputView"
             x:Name="Root">
    <ContentView.Resources>
        <local:NumericTextConverter x:Key="NumericTextConverter" />
    </ContentView.Resources>
    <!-- See NumericInputView for why the label row is "*" and not "Auto". -->
    <Grid RowDefinitions="*,Auto,Auto"
          RowSpacing="{StaticResource SpaceXs}">
        <local:FieldHelpView Header="{Binding Header, Source={x:Reference Root}}"
                             HelpText="{Binding HelpText, Source={x:Reference Root}}"
                             VerticalOptions="Start" />
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="6">
            <Entry Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                   Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                   Keyboard="Numeric"
                   Background="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   PlaceholderColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}"
                   SemanticProperties.Description="{Binding HelpText, Source={x:Reference Root}}" />
            <Label Grid.Column="1"
                   Text="%"
                   VerticalTextAlignment="Center"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource PlaceholderLight}, Dark={StaticResource PlaceholderDark}}"
                   SemanticProperties.Description="Percentage" />
        </Grid>
        <local:SteppedSlider Grid.Row="2"
                             Minimum="{Binding Minimum, Source={x:Reference Root}}"
                             Maximum="{Binding Maximum, Source={x:Reference Root}}"
                             StepSize="{Binding Step, Source={x:Reference Root}}"
                             Value="{Binding Text, Source={x:Reference Root}, Mode=TwoWay, Converter={StaticResource NumericTextConverter}}"
                             SemanticProperties.Description="{Binding HelpText, Source={x:Reference Root}}" />
    </Grid>
</ContentView>
