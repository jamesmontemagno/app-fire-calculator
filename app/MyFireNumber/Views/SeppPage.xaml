<?xml version="1.0" encoding="utf-8" ?>
<views:CalculatorPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                           xmlns:controls="clr-namespace:MyFireNumber.Views.Controls"
                           xmlns:views="clr-namespace:MyFireNumber.Views"
                           xmlns:viewModels="clr-namespace:MyFireNumber.ViewModels"
                           xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
                           x:Class="MyFireNumber.Views.SeppPage"
                           x:DataType="viewModels:SeppViewModel"
                           Title="{Binding Title}"
                           Shell.NavBarIsVisible="True"
                           Background="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource SurfacePageDark}}"
                           SafeAreaEdges="All">
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding SavePlanAndCloseCommand}" SemanticProperties.Description="Save the current 72(t) values as a plan.">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FontAwesomeSolid" Glyph="&#xf0c7;" Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" Size="18" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceLg}">
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" />
            <Border IsVisible="{Binding HasValidationMessage}" Padding="14"
                    Background="{AppThemeBinding Light={StaticResource SurfaceWarningLight}, Dark={StaticResource SurfaceWarningDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarningLight}, Dark={StaticResource BorderWarningDark}}"
                    StrokeShape="RoundRectangle 8">
                <Label Text="{Binding ValidationMessage}" TextColor="{AppThemeBinding Light={StaticResource TextWarningLight}, Dark={StaticResource TextWarningDark}}" />
            </Border>

            <controls:CalculatorInfoView Title="What is a 72(t) / SEPP plan?"
                                         Summary="Estimate substantially equal periodic payments that may avoid the additional 10% tax on early retirement-plan distributions."
                                         Details="A SEPP series is a strict tax arrangement, not simply a withdrawal strategy. This calculator uses the IRS Single Life table and compares the required minimum distribution and fixed amortization safe-harbor methods. Fixed annuitization requires an actuarial factor supplied by a qualified professional."
                                         IconGlyph="&#xf571;" />

            <Border Padding="{StaticResource CardPadding}"
                    Background="{AppThemeBinding Light={StaticResource SurfaceWarningLight}, Dark={StaticResource SurfaceWarningDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarningLight}, Dark={StaticResource BorderWarningDark}}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                    <Label Text="Verify eligibility before relying on this estimate" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextWarningLight}, Dark={StaticResource TextWarningDark}}" />
                    <Label Text="Employer plans may not permit early distributions. Inherited IRAs generally do not need this exception; governmental 457(b) plans generally are not subject to the additional 10% tax; and a SIMPLE IRA within its first two years has different penalty rules. Roth distributions also require separate ordering analysis."
                           FontSize="12" LineHeight="1.3"
                           TextColor="{AppThemeBinding Light={StaticResource TextWarningLight}, Dark={StaticResource TextWarningDark}}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="{StaticResource CardPadding}"
                    Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                        <Label Text="SEPP account" Style="{StaticResource CalculatorSectionHeading}" />
                        <Button Grid.Column="1" Text="Reset" Command="{Binding ResetDefaultsCommand}"
                                Background="{StaticResource Secondary}" TextColor="{StaticResource PrimaryDarkText}" FontSize="12"
                                SemanticProperties.Description="Reset 72(t) / SEPP values to their defaults." />
                    </Grid>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Account" Style="{StaticResource FormFieldLabel}" />
                        <Picker AutomationId="SeppAccountPicker"
                                ItemsSource="{Binding Accounts}"
                                SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                ItemDisplayBinding="{Binding Name}"
                                Style="{StaticResource FormPicker}"
                                SemanticProperties.Description="Retirement account used for this SEPP estimate" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Account name" Style="{StaticResource FormFieldLabel}" />
                        <Entry Text="{Binding AccountNameText, Mode=TwoWay}" IsEnabled="{Binding CanEditProfileOwnedFields}"
                               Style="{StaticResource FormEntry}" Placeholder="Traditional IRA" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceMd}">
                        <controls:NumericInputView Header="Account balance" HelpText="Balance dedicated to this SEPP series. Do not combine unrelated accounts." Placeholder="500000"
                                                   Text="{Binding AccountBalanceText}" IsEnabled="{Binding CanEditProfileOwnedFields}" />
                        <controls:PercentageInputView Grid.Column="1" Header="Expected return" HelpText="Used only for the illustrative balance projection, not the IRS payment formula."
                                                      Placeholder="5" Minimum="-100" Maximum="100" Step="0.1"
                                                      Text="{Binding ExpectedReturnText}" IsEnabled="{Binding CanEditProfileOwnedFields}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="{StaticResource CardPadding}"
                    Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                    <Label Text="Payment setup" Style="{StaticResource CalculatorSectionHeading}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceMd}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Birth date" Style="{StaticResource FormFieldLabel}" />
                            <DatePicker AutomationId="SeppBirthDatePicker" Date="{Binding BirthDate}"
                                        IsEnabled="{Binding CanEditProfileOwnedFields}" Style="{StaticResource FormDatePicker}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="First payment" Style="{StaticResource FormFieldLabel}" />
                            <DatePicker AutomationId="SeppFirstPaymentDatePicker" Date="{Binding FirstPaymentDate}" Style="{StaticResource FormDatePicker}" />
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Calculation method" Style="{StaticResource FormFieldLabel}" />
                        <Picker AutomationId="SeppMethodPicker" ItemsSource="{Binding MethodOptions}"
                                SelectedItem="{Binding SelectedMethod, Mode=TwoWay}" ItemDisplayBinding="{Binding Name}"
                                Style="{StaticResource FormPicker}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceMd}">
                        <controls:PercentageInputView Header="Chosen interest rate" HelpText="Used for the fixed methods. It cannot exceed the permitted maximum."
                                                      Placeholder="5" Minimum="0" Maximum="20" Step="0.01" Text="{Binding InterestRateText}" />
                        <controls:PercentageInputView Grid.Column="1" Header="Maximum permitted rate" HelpText="Enter the greater of 5% or 120% of the applicable federal mid-term rate for either of the two preceding months."
                                                      Placeholder="5" Minimum="0" Maximum="20" Step="0.01" Text="{Binding MaximumInterestRateText}" />
                    </Grid>
                    <controls:AdvancedAssumptionsExpander>
                        <VerticalStackLayout Margin="0,12,0,0" Spacing="{StaticResource SpaceSm}">
                            <controls:NumericInputView Header="Actuarial annuity factor"
                                                       HelpText="Required only for fixed annuitization. Obtain the exact factor using the IRS mortality table and chosen rate from a qualified professional or compliant actuarial tool."
                                                       Placeholder="Optional" Text="{Binding AnnuityFactorText}" />
                            <Label Text="The app does not approximate this factor because an approximation is not an IRS safe-harbor calculation."
                                   Style="{StaticResource CalculatorSupportingText}" />
                        </VerticalStackLayout>
                    </controls:AdvancedAssumptionsExpander>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                <Label Text="Estimated payment" Style="{StaticResource CalculatorSectionHeading}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}" RowSpacing="{StaticResource SpaceSm}">
                    <Border Padding="{StaticResource CardPaddingCompact}" Background="{AppThemeBinding Light={StaticResource SurfaceAccentTintFlatLight}, Dark={StaticResource SurfaceAccentTintFlatDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2"><Label Text="Annual payment" FontSize="12" /><Label AutomationId="SeppAnnualPaymentLabel" Text="{Binding SelectedAnnualPaymentText}" FontAttributes="Bold" FontSize="20" /></VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="{StaticResource CardPaddingCompact}" Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2"><Label Text="Monthly equivalent" FontSize="12" /><Label Text="{Binding SelectedMonthlyPaymentText}" FontAttributes="Bold" FontSize="18" /></VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Padding="{StaticResource CardPaddingCompact}" Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2"><Label Text="Continue through" FontSize="12" /><Label Text="{Binding RequiredEndDateText}" FontAttributes="Bold" FontSize="18" /><Label Text="{Binding RequiredTermText}" FontSize="11" /></VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Padding="{StaticResource CardPaddingCompact}" Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2"><Label Text="Starting age / IRS factor" FontSize="12" /><Label Text="{Binding StartingAgeText, StringFormat='Age {0}'}" FontAttributes="Bold" FontSize="18" /><Label Text="{Binding LifeExpectancyFactorText, StringFormat='Single Life factor {0}'}" FontSize="11" /></VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <Border Padding="{StaticResource CardPadding}"
                    Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                    <Label Text="Method comparison" Style="{StaticResource CalculatorSectionHeading}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                        <Label Text="RMD first year" /><Label Grid.Column="1" Text="{Binding RmdPaymentText}" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="Fixed amortization" /><Label Grid.Row="1" Grid.Column="1" Text="{Binding AmortizationPaymentText}" FontAttributes="Bold" />
                        <Label Grid.Row="2" Text="Fixed annuitization" /><Label Grid.Row="2" Grid.Column="1" Text="{Binding AnnuitizationPaymentText}" FontAttributes="Bold" />
                    </Grid>
                    <Label Text="RMD payments must be recalculated annually. Fixed-method payments generally remain unchanged unless a permitted one-time switch to RMD is made."
                           Style="{StaticResource CalculatorSupportingText}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                <Label Text="Illustrative account projection" Style="{StaticResource CalculatorSectionHeading}" />
                <controls:InteractiveCartesianChartView Series="{Binding ProjectionSeries}" XAxes="{Binding ProjectionXAxes}"
                                    AnimationsSpeed="{Binding ChartAnimationsSpeed}" ChartHeight="300"
                                    SemanticProperties.Description="{Binding ProjectionChartDescription}" />
                <Label Text="{Binding ProjectionSummary}" Style="{StaticResource CalculatorSupportingText}" />
            </VerticalStackLayout>

            <Border Padding="{StaticResource CardPadding}"
                    Background="{AppThemeBinding Light={StaticResource SurfaceWarningLight}, Dark={StaticResource SurfaceWarningDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarningLight}, Dark={StaticResource BorderWarningDark}}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                    <Label Text="A modification can trigger retroactive tax and interest" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextWarningLight}, Dark={StaticResource TextWarningDark}}" />
                    <Label Text="Payments generally must continue until the later of five years after the first payment or age 59½. Adding money, transferring funds, changing payments outside permitted rules, or otherwise modifying the account can break the series. Keep professional calculations and account records."
                           FontSize="12" LineHeight="1.3"
                           TextColor="{AppThemeBinding Light={StaticResource TextWarningLight}, Dark={StaticResource TextWarningDark}}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="{StaticResource CardPadding}"
                    Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
                    <Label Text="Save or export this estimate" Style="{StaticResource CalculatorSectionHeading}" />
                    <Entry Text="{Binding PlanNameText}" Placeholder="My 72(t) SEPP Plan" Style="{StaticResource FormEntry}" SemanticProperties.Description="Name for this saved 72(t) / SEPP plan" />
                    <Button Text="{Binding SavePlanActionText}" Command="{Binding SavePlanAndCloseCommand}" SemanticProperties.Description="{Binding SavePlanActionDescription}" />
                    <Button Text="Export to Excel" Command="{Binding ExportCommand}" Background="{StaticResource Secondary}" TextColor="{StaticResource PrimaryDarkText}" SemanticProperties.Description="Create a 72(t) / SEPP workbook on this device and open the native share sheet." />
                    <Label IsVisible="{Binding HasPlanStatusMessage}" Text="{Binding PlanStatusMessage}" Style="{StaticResource CalculatorSupportingText}" />
                    <Label IsVisible="{Binding HasExportStatusMessage}" Text="{Binding ExportStatusMessage}" Style="{StaticResource CalculatorSupportingText}" />
                    <controls:EducationalDisclaimerView />
                </VerticalStackLayout>
            </Border>

            <controls:CalculationExplanationView Explanation="RMD method: prior-year account balance divided by the IRS Single Life factor for that year's attained age; it is recalculated annually.&#10;&#10;Fixed amortization: payment = (rate x balance) / (1 - (1 + rate)^(-life expectancy factor)).&#10;&#10;Fixed annuitization: balance divided by a compliant actuarial annuity factor. The app requires that factor rather than approximating it.&#10;&#10;The interest-rate ceiling is the greater of 5% or 120% of the applicable federal mid-term rate for either of the two months before payments begin. Verify the entered ceiling for your start month." />
        </VerticalStackLayout>
    </ScrollView>
</views:CalculatorPageBase>
